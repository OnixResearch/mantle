# Build GNU Make from source using the bootstrap seed toolchain.
#
# Part of the Nix-free bootstrap chain:
#   seed → make (this file) → bash → coreutils → ...
#
# Usage:
#   crunch build bootstrap/make.ncl -I lib --store /tmp/crunch-store
#
# Bypasses autoconf entirely (busybox grep is too limited for
# configure's long-line test). Compiles sources directly with a
# hand-written config.h tuned for musl libc on x86_64-linux.

let crunch = import "lib.ncl" in

let seed = import "seed.ncl" in
let toolchain = seed.toolchain in
let seed_name = seed.name in
let seed_target = seed.target in

let make_src = crunch.fetchTarball {
  url = "https://ftpmirror.gnu.org/make/make-4.4.1.tar.gz",
  hash = "sha256-+Cg7R8wougcWcFf6u5B3lVX6RRgMRYZ1CD+e21URP5A=",
  name = "make-src",
} in

{
  name = "gnumake",
  builder = "/bin/sh",
  args = [
    "-c",
    m%"
      BB=/bin/busybox
      $BB mkdir -p /tmp/tools
      for cmd in cat mkdir cp chmod ln ls echo rm mv sed grep awk \
                 tr head tail sort wc expr test basename dirname \
                 install find xargs readlink sleep touch date od \
                 uname id hostname diff cmp true false tee; do
        $BB ln -sf $BB /tmp/tools/$cmd
      done
      export PATH="/tmp/tools"

      # Find the bootstrap seed toolchain.
      TOOLCHAIN=""
      for d in $NIX_STORE/*-%{seed_name}; do
        if [ -d "$d" ]; then TOOLCHAIN="$d"; break; fi
      done
      if [ -z "$TOOLCHAIN" ]; then
        echo "ERROR: bootstrap seed toolchain not found" >&2; exit 1
      fi

      # Find make source.
      SRCDIR=""
      for d in $NIX_STORE/*-make-src; do
        if [ -d "$d" ]; then SRCDIR="$d"; break; fi
      done
      if [ -z "$SRCDIR" ]; then
        echo "ERROR: make-src not found" >&2; exit 1
      fi

      export CC="$TOOLCHAIN/bin/%{seed_target}-gcc"
      export AR="$TOOLCHAIN/bin/%{seed_target}-ar"
      export RANLIB="$TOOLCHAIN/bin/%{seed_target}-ranlib"
      export CFLAGS="-static -O2 -D_GNU_SOURCE -include stddef.h"
      export LDFLAGS="-static"

      # Copy source to writable /tmp (sandbox mounts are read-only).
      $BB cp -r "$SRCDIR" /tmp/make-build 2>/dev/null
      $BB chmod -R u+w /tmp/make-build
      cd /tmp/make-build

      # ── config.h for musl libc on x86_64-linux ──
      # Bypasses autoconf. musl provides POSIX + common extensions.
      cat > src/config.h << 'CFGEOF'
/* Generated by crunch bootstrap — not autoconf. */
/* Tuned for musl libc on x86_64-linux. */

/* Standard headers (musl has all of these) */
#define HAVE_STRING_H 1
#define HAVE_STDLIB_H 1
#define HAVE_UNISTD_H 1
#define HAVE_LIMITS_H 1
#define HAVE_LOCALE_H 1
#define HAVE_FCNTL_H 1
#define HAVE_ALLOCA_H 1
#define HAVE_MEMORY_H 1
#define HAVE_DIRENT_H 1
#define HAVE_STDINT_H 1
#define HAVE_INTTYPES_H 1
#define HAVE_SIGNAL_H 1
#define HAVE_SYS_PARAM_H 1
#define HAVE_SYS_STAT_H 1
#define HAVE_SYS_TIME_H 1
#define HAVE_SYS_TYPES_H 1
#define HAVE_SYS_WAIT_H 1
#define HAVE_SYS_FILE_H 1
#define HAVE_SYS_RESOURCE_H 1
#define HAVE_SYS_SELECT_H 1
#define HAVE_STRINGS_H 1

/* Functions (musl has all of these) */
#define HAVE_DUP 1
#define HAVE_DUP2 1
#define HAVE_GETCWD 1
#define HAVE_MKSTEMP 1
#define HAVE_MKTEMP 1
#define HAVE_STRERROR 1
#define HAVE_STRSIGNAL 1
#define HAVE_STRNDUP 1
#define HAVE_STRTOLL 1
#define HAVE_ISATTY 1
#define HAVE_TTYNAME 1
#define HAVE_FDOPEN 1
#define HAVE_FILENO 1
#define HAVE_SETLINEBUF 1
#define HAVE_SETVBUF 1
#define HAVE_STRNCASECMP 1
#define HAVE_UMASK 1
#define HAVE_MKFIFO 1
#define HAVE_REALPATH 1
#define HAVE_ATEXIT 1
#define HAVE_GETCWD 1
#define HAVE_GETRLIMIT 1
#define HAVE_SETRLIMIT 1
#define HAVE_GETTIMEOFDAY 1
#define HAVE_PSELECT 1
#define HAVE_VFORK 1
#define HAVE_WAIT_NOHANG 1
#define HAVE_WAITPID 1
#define HAVE_MEMPCPY 1
#define HAVE_MEMRCHR 1
#define HAVE_SA_RESTART 1
#define HAVE_CLOCK_GETTIME 1
#define HAVE_STRUCT_DIRENT_D_TYPE 1
#define HAVE_POSIX_SPAWNATTR_SETSIGMASK 1

/* Timestamps: musl uses st_mtim.tv_nsec (POSIX standard) */
#define FILE_TIMESTAMP_HI_RES 1
#define ST_MTIM_NSEC st_mtim.tv_nsec

/* Package info */
#define PACKAGE "make"
#define PACKAGE_VERSION "4.4.1"
#define VERSION "4.4.1"

/* Paths (not used in bootstrap, but headers reference them) */
#define LOCALEDIR "/dev/null"
#define INCLUDEDIR "/dev/null"
#define LIBDIR "/dev/null"

/* SCCS */
#define SCCS_GET "get"

/* No NLS, no guile, no dmalloc */
#undef ENABLE_NLS
#undef HAVE_GUILE
#undef HAVE_DMALLOC_H

/* _GNU_SOURCE is defined via -D on the command line to ensure
   it appears before any system headers. */

/* Use system glob/fnmatch (musl provides POSIX versions).
   GNU Make's dir_setup_glob() uses GLOB_ALTDIRFUNC which musl
   doesn't support. We stub it out — Make works fine without the
   custom directory stream optimization. */
/* Linux/ext4 is case-sensitive. Do NOT define HAVE_CASE_INSENSITIVE_FS
   — the code uses #ifdef, so even defining it to 0 enables it. */
/* #undef HAVE_CASE_INSENSITIVE_FS */

/* musl lacks GLOB_ALTDIRFUNC. Define to 0 so the flag is ignored
   by glob() and the custom dir functions in dir_setup_glob are
   patched out anyway. */
#ifndef GLOB_ALTDIRFUNC
#define GLOB_ALTDIRFUNC 0
#endif
CFGEOF

      # Patch dir.c to stub out dir_setup_glob (uses GLOB_ALTDIRFUNC
      # which musl doesn't support). Replace the function body with
      # just setting gl_offs.
      sed -i 's/gl->gl_opendir = open_dirstream;//' src/dir.c
      sed -i 's/gl->gl_readdir = read_dirstream;//' src/dir.c
      sed -i 's/gl->gl_closedir = free;//' src/dir.c
      sed -i 's/gl->gl_lstat = local_lstat;//' src/dir.c
      sed -i 's/gl->gl_stat = local_stat;//' src/dir.c

      # ── Compile ──
      mkdir -p /tmp/obj

      SRCS="src/ar.c src/arscan.c src/commands.c src/default.c
            src/dir.c src/expand.c src/file.c src/function.c
            src/getopt.c src/getopt1.c src/hash.c src/implicit.c
            src/job.c src/load.c src/loadapi.c src/main.c
            src/misc.c src/output.c src/read.c src/remake.c
            src/remote-stub.c src/rule.c src/shuffle.c
            src/signame.c src/strcache.c src/variable.c
            src/version.c src/vpath.c src/posixos.c
            src/guile.c"

      for f in $SRCS; do
        base=$(basename $f .c)
        echo "CC $f"
        $CC $CFLAGS -I src -I lib -I . -DHAVE_CONFIG_H -c -o /tmp/obj/$base.o $f || exit 1
      done

      # Stub out lib/ dependencies. concat-filename and findprog-in
      # are used by load.c for dlopen module path resolution.
      # We don't need loadable modules in bootstrap make, so provide
      # dummy stubs.
      cat > /tmp/obj/lib_stubs.c << 'STUBEOF'
#include <stdlib.h>
char *concatenated_filename(const char *d, const char *f, const char *s) { return NULL; }
const char *find_in_given_path(const char *n, const char *p, const char *d, int o) { return NULL; }
STUBEOF
      echo "CC lib_stubs.c"
      $CC $CFLAGS -c -o /tmp/obj/lib_stubs.o /tmp/obj/lib_stubs.c || exit 1

      echo "LINK make"
      $CC $LDFLAGS -o /tmp/make /tmp/obj/*.o || exit 1

      # Install
      mkdir -p $out/bin
      cp /tmp/make $out/bin/make
      chmod 755 $out/bin/make

      # Verify
      echo "=== make --version ==="
      $out/bin/make --version
    "%,
  ],
  inputs = [toolchain, make_src],
} | crunch.Derivation

# Build dash (Debian Almquist Shell) from source using musl-gcc + make.
#
# Part of the Nix-free bootstrap chain:
#   musl-gcc (fetched) → make (from source) → dash (this file) → ...
#
# Usage:
#   crunch build bootstrap/dash.ncl -I lib --store /tmp/crunch-store
#
# Dash is a minimal POSIX shell (~28 source files + code generators).
# It needs: musl-gcc, GNU Make, and busybox for shell scripts.
#
# The build has two phases:
#   Phase A: run code generators (shell scripts + compiled tools)
#            to produce generated .c/.h files
#   Phase B: compile all sources and link statically

let crunch = import "lib.ncl" in

let seed = import "seed.ncl" in
let toolchain = seed.toolchain in
let seed_name = seed.name in
let seed_target = seed.target in

let make_src = crunch.fetchTarball {
  url = "https://ftp.gnu.org/gnu/make/make-4.4.1.tar.gz",
  hash = "sha256-+Cg7R8wougcWcFf6u5B3lVX6RRgMRYZ1CD+e21URP5A=",
  name = "make-src",
} in

let gnumake = (import "make.ncl") in

let dash_src = crunch.fetchTarball {
  url = "http://gondor.apana.org.au/~herbert/dash/files/dash-0.5.12.tar.gz",
  hash = "sha256-cL8rcGuwzcraI5zOZTt0Me9H1IJCXBBmOtgzbGqPSM4=",
  name = "dash-src",
} in

{
  name = "dash",
  builder = "/bin/sh",
  args = [
    "-c",
    m%"
      BB=/bin/busybox
      $BB mkdir -p /tmp/tools
      for cmd in cat mkdir cp chmod ln ls echo rm mv sed grep awk \
                 tr head tail sort wc expr test basename dirname \
                 install find xargs readlink sleep touch date od \
                 uname id hostname diff cmp true false tee sh nl; do
        $BB ln -sf $BB /tmp/tools/$cmd
      done
      export PATH="/tmp/tools"

      # Find the bootstrap seed toolchain.
      TOOLCHAIN=""
      for d in $NIX_STORE/*-%{seed_name}; do
        if [ -d "$d" ]; then TOOLCHAIN="$d"; break; fi
      done
      if [ -z "$TOOLCHAIN" ]; then
        echo "ERROR: bootstrap seed toolchain not found" >&2; exit 1
      fi

      # Find GNU Make.
      MAKE=""
      for d in $NIX_STORE/*-gnumake; do
        if [ -x "$d/bin/make" ]; then MAKE="$d/bin/make"; break; fi
      done
      if [ -z "$MAKE" ]; then
        echo "ERROR: gnumake not found" >&2; exit 1
      fi

      # Find dash source.
      SRCDIR=""
      for d in $NIX_STORE/*-dash-src; do
        if [ -d "$d" ]; then SRCDIR="$d"; break; fi
      done
      if [ -z "$SRCDIR" ]; then
        echo "ERROR: dash-src not found" >&2; exit 1
      fi

      export CC="$TOOLCHAIN/bin/%{seed_target}-gcc"
      export AR="$TOOLCHAIN/bin/%{seed_target}-ar"
      export CFLAGS="-static -O2 -D_GNU_SOURCE"
      export LDFLAGS="-static"

      # Copy source to writable /tmp.
      $BB cp -r "$SRCDIR" /tmp/dash-build 2>/dev/null
      $BB chmod -R u+w /tmp/dash-build
      cd /tmp/dash-build/src

      # ── config.h for musl libc on x86_64-linux ──
      cat > ../config.h << 'CFGEOF'
/* Generated by crunch bootstrap — not autoconf. */
/* Tuned for musl libc on x86_64-linux with dash 0.5.12. */

/* Standard headers */
#define HAVE_ALLOCA_H 1
#define HAVE_INTTYPES_H 1
#define HAVE_MEMORY_H 1
#define HAVE_PATHS_H 1
#define HAVE_STDINT_H 1
#define HAVE_STDLIB_H 1
#define HAVE_STRINGS_H 1
#define HAVE_STRING_H 1
#define HAVE_SYS_STAT_H 1
#define HAVE_SYS_TYPES_H 1
#define HAVE_UNISTD_H 1
#define STDC_HEADERS 1

/* Functions musl provides */
#define HAVE_BSEARCH 1
#define HAVE_FACCESSAT 1
#define HAVE_FNMATCH 1
#define HAVE_GETPWNAM 1
#define HAVE_GETRLIMIT 1
/* musl's glob lacks GNU extensions (GLOB_NOMAGIC, GLOB_ALTDIRFUNC,
   gl_flags). Dash has its own glob fallback — use it. */
/* #undef HAVE_GLOB */
#define HAVE_ISALPHA 1
#define HAVE_KILLPG 1
#define HAVE_MEMPCPY 1
/* sigsetmask is BSD legacy — musl provides it but dash should
   use sigprocmask instead (system.h falls through to it). */
/* #undef HAVE_SIGSETMASK */
#define HAVE_STPCPY 1
#define HAVE_STRCHRNUL 1
#define HAVE_STRSIGNAL 1
#define HAVE_STRTOD 1
#define HAVE_STRTOIMAX 1
#define HAVE_STRTOUMAX 1
#define HAVE_SYSCONF 1
#define HAVE_DECL_ISBLANK 1
#define HAVE_ALIAS_ATTRIBUTE 1
#define HAVE_ST_MTIM 1
#define HAVE_TRADITIONAL_FACCESSAT 0

/* Enable job control */
#define JOBS 1

/* Enable line numbers in error messages */
#define WITH_LINENO 1

/* Sizes for intmax_t support */
#define SIZEOF_INTMAX_T 8
#define SIZEOF_LONG_LONG_INT 8
#define PRIdMAX "ld"

/* Paths */
#define _PATH_BSHELL "/bin/sh"
#define _PATH_DEVNULL "/dev/null"
#define _PATH_TTY "/dev/tty"

/* Package info */
#define PACKAGE "dash"
#define PACKAGE_NAME "dash"
#define PACKAGE_BUGREPORT ""
#define PACKAGE_STRING "dash 0.5.12"
#define PACKAGE_TARNAME "dash"
#define PACKAGE_URL ""
#define PACKAGE_VERSION "0.5.12"
#define VERSION "0.5.12"

/* SMALL mode — disables history/line-editing (requires libedit
   which we don't have in the bootstrap environment). Dash is
   fully functional for scripting without it. */
#define SMALL 1

/* signal is fine on Linux */
/* #undef signal */

/* No LFS64 aliases needed on musl (it's always 64-bit) */
/* #undef dirent64 */
/* #undef fstat64 */
/* #undef glob64 */
/* #undef glob64_t */
/* #undef globfree64 */
/* #undef lstat64 */
/* #undef open64 */
/* #undef readdir64 */
/* #undef stat64 */
CFGEOF

      # ── Phase A: Code generation ──
      echo "=== Phase A: generating source files ==="

      # 1. mktokens → token.h, token_vars.h
      echo "GEN token.h token_vars.h"
      TMPDIR=/tmp sh mktokens || exit 1

      # Code generators must be statically linked (bwrap has no
      # dynamic linker). Use $CC $CFLAGS which includes -static.

      # 2. mksignames → signames.c
      echo "GEN mksignames"
      $CC $CFLAGS -o /tmp/mksignames mksignames.c || exit 1
      echo "GEN signames.c"
      /tmp/mksignames > signames.c || exit 1

      # 3. mknodes → nodes.c, nodes.h
      echo "GEN mknodes"
      $CC $CFLAGS -o /tmp/mknodes mknodes.c || exit 1
      echo "GEN nodes.c nodes.h"
      /tmp/mknodes nodetypes nodes.c.pat || exit 1

      # 4. mksyntax → syntax.c, syntax.h (needs token.h via parser.h)
      echo "GEN mksyntax"
      $CC $CFLAGS -I. -o /tmp/mksyntax mksyntax.c || exit 1
      echo "GEN syntax.c syntax.h"
      /tmp/mksyntax || exit 1

      # 5. builtins.def: preprocess builtins.def.in with config.h
      echo "GEN builtins.def"
      $CC -E -x c -include ../config.h -o builtins.def builtins.def.in || exit 1

      # 6. mkbuiltins + builtins.def → builtins.c, builtins.h
      echo "GEN builtins.c builtins.h"
      TMPDIR=/tmp sh mkbuiltins builtins.def || exit 1

      # 7. mkinit → init.c (scans all source files for INIT/RESET/etc blocks)
      echo "GEN mkinit"
      $CC $CFLAGS -o /tmp/mkinit mkinit.c || exit 1
      echo "GEN init.c"
      /tmp/mkinit \
        alias.c arith_yacc.c arith_yylex.c cd.c error.c eval.c \
        exec.c expand.c input.c jobs.c mail.c main.c \
        memalloc.c miscbltin.c mystring.c options.c parser.c \
        redir.c show.c trap.c output.c system.c var.c || exit 1

      # ── Phase B: Compile ──
      echo "=== Phase B: compiling ==="
      mkdir -p /tmp/obj

      # histedit.c excluded — requires libedit which we don't have.
      # Dash works fine without history/line-editing in scripts.
      SRCS="alias.c arith_yacc.c arith_yylex.c cd.c error.c eval.c
            exec.c expand.c input.c jobs.c mail.c main.c
            memalloc.c miscbltin.c mystring.c options.c parser.c
            redir.c show.c trap.c output.c system.c var.c
            bltin/printf.c bltin/test.c bltin/times.c"

      GENERATED="builtins.c init.c nodes.c signames.c syntax.c"

      ALLSRC="$SRCS $GENERATED"

      for f in $ALLSRC; do
        base=$(echo $f | sed 's|.*/||; s|\.c$||')
        echo "CC $f"
        $CC $CFLAGS -DSHELL -I. -I.. -include ../config.h -c -o /tmp/obj/$base.o $f || exit 1
      done

      echo "LINK dash"
      $CC $LDFLAGS -o /tmp/dash /tmp/obj/*.o || exit 1

      # Install
      mkdir -p $out/bin
      cp /tmp/dash $out/bin/dash
      chmod 755 $out/bin/dash
      # Also provide as /bin/sh
      ln -s dash $out/bin/sh

      # Verify
      echo "=== dash --version ==="
      $out/bin/dash -c 'echo "dash ok: $0"' dash
      echo "=== POSIX test ==="
      $out/bin/dash -c 'x=hello; echo "${x} world"; for i in 1 2 3; do echo $i; done'
    "%,
  ],
  inputs = [toolchain, gnumake, dash_src],
} | crunch.Derivation

{
  "schema": "mantle-full-musl-binutils-provider-contract-v1",
  "musl_derivation": "bootstrap/musl-full.ncl",
  "binutils_derivation": "bootstrap/binutils-full.ncl",
  "status": "contract-only",
  "musl_required_markers": [
    "GCC=$(find_input gcc-10.5.0-musl-gcc47-v2)",
    "CLEAN_CC=\"$TOOLBIN/gcc10\"",
    "CC=\"$CLEAN_CC\"",
    "test -s \"$out/usr/lib/libc.a\"",
    "test -e \"$out/lib/ld-musl-x86_64.so.1\"",
    "gcc10-musl-1.2.5-smoke-ok",
    "ERROR: GCC 10/musl 1.2.5 accepted malformed C"
  ],
  "binutils_required_markers": [
    "GCC=$(find_input gcc-10.5.0-musl-final-v1)",
    "MUSL=$(find_input musl-1.2.5-gcc10-v1)",
    "CC=\"$HOST_CC\"",
    "CXX=\"$HOST_CXX\"",
    "--with-sysroot=\"$MUSL\"",
    "make -j\"$JOB_COUNT\" MAKEINFO=true",
    "make -j\"$JOB_COUNT\" install MAKEINFO=true",
    "for required_tool in as ld ar ranlib nm objcopy objdump readelf size strings strip; do",
    "\"$out/bin/readelf\" -h \"$WORK/positive.o\"",
    "\"$out/bin/objcopy\" \"$WORK/positive.o\" \"$WORK/positive-copy.o\""
  ],
  "parity_effect": "evidence-backed partial; does not prove full musl/binutils correctness"
}

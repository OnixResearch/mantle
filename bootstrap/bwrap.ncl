# Build bubblewrap (bwrap) from source using the bootstrap GCC + musl.
#
# Part of the Nix-free bootstrap chain:
#   musl-gcc (fetched) -> make -> dash -> binutils -> musl -> gcc
#     -> bwrap (this file)
#
# Compiles bwrap directly with gcc — bypasses meson entirely.
# bwrap is ~2000 lines of C in 4 source files. No meson/python needed.
#
# Usage:
#   crunch build bootstrap/bwrap.ncl -I lib --store /tmp/crunch-store

let crunch = import "lib.ncl" in

let toolchain = crunch.fetchTarball {
  url = "https://musl.cc/x86_64-linux-musl-native.tgz",
  hash = "sha256-XpcI34j9YwAQj7qw4DpvXqT1CX00vHcUQbAk/do46jw=",
  name = "musl-gcc",
} in

let binutils = (import "binutils.ncl") in
let musl = (import "musl.ncl") in
let gcc = (import "gcc.ncl") in

let bwrap_src = crunch.fetchTarball {
  url = "https://github.com/containers/bubblewrap/releases/download/v0.11.0/bubblewrap-0.11.0.tar.xz",
  hash = "sha256-8IDMLQPeO576N1lizVudXUmTV6hNOiowjzRpEWBsZ+U=",
  name = "bwrap-src",
} in

{
  name = "bwrap",
  builder = "/bin/sh",
  args = [
    "-c",
    m%"
      set -e
      BB=/bin/busybox
      $BB mkdir -p /tmp/tools
      for cmd in cat mkdir cp chmod ln ls echo rm mv sed grep awk \
                 tr head tail sort wc expr test basename dirname \
                 install find xargs readlink sleep touch date od \
                 uname id true false tee sh env which; do
        $BB ln -sf $BB /tmp/tools/$cmd
      done
      export PATH="/tmp/tools"

      # Find GCC.
      GCC=""
      for d in /nix/store/*-gcc; do
        if [ -x "$d/bin/gcc" ]; then GCC="$d"; break; fi
      done
      if [ -z "$GCC" ]; then
        echo "ERROR: gcc not found" >&2; exit 1
      fi
      # Find binutils.
      BINUTILS=""
      for d in /nix/store/*-binutils; do
        if [ -d "$d/bin" ]; then BINUTILS="$d"; break; fi
      done
      # Symlink unprefixed binutils tools.
      if [ -n "$BINUTILS" ]; then
        for tool in as ld ar nm objcopy objdump ranlib readelf strip; do
          if [ -x "$BINUTILS/bin/x86_64-linux-musl-$tool" ] && [ ! -e "/tmp/tools/$tool" ]; then
            $BB ln -sf "$BINUTILS/bin/x86_64-linux-musl-$tool" /tmp/tools/$tool
          fi
        done
      fi

      export PATH="$GCC/bin${BINUTILS:+:$BINUTILS/bin}:$PATH"

      # Create musl dynamic linker symlink.
      MUSL=""
      for d in /nix/store/*-musl; do
        if [ -f "$d/lib/libc.so" ]; then MUSL="$d"; break; fi
      done
      if [ -z "$MUSL" ]; then
        for d in /nix/store/*-musl-gcc; do
          if [ -f "$d/lib/libc.so" ]; then MUSL="$d"; break; fi
        done
      fi
      if [ -n "$MUSL" ]; then
        $BB mkdir -p /lib 2>/dev/null || true
        $BB ln -sf "$MUSL/lib/libc.so" /lib/ld-musl-x86_64.so.1 2>/dev/null || true
      fi

      # Find bwrap source.
      SRCDIR=""
      for d in /nix/store/*-bwrap-src; do
        if [ -d "$d" ]; then SRCDIR="$d"; break; fi
      done
      if [ -z "$SRCDIR" ]; then
        echo "ERROR: bwrap-src not found" >&2; exit 1
      fi

      # Copy source to writable location.
      cp -r "$SRCDIR" /tmp/build 2>/dev/null
      chmod -R u+w /tmp/build
      cd /tmp/build

      # Write config.h for Linux 5.x+ with musl libc.
      cat > config.h << 'CONFIGEOF'
/* config.h -- generated by crunch bootstrap, not autoconf */
#define PACKAGE_STRING "bubblewrap 0.11.0"

/* Linux 5.x+ syscall support */
/* HAVE_SELINUX intentionally undefined -- no SELinux support */
/* ENABLE_REQUIRE_USERNS intentionally undefined -- optional */
CONFIGEOF

      # Set up musl library paths.
      GCC_LIB=$(dirname $(gcc -print-libgcc-file-name))
      export LIBRARY_PATH="$GCC_LIB:${LIBRARY_PATH:-}"

      # Compile all source files.
      # bwrap uses raw capget/capset syscalls (linux kernel headers),
      # not libcap. No -lcap needed.
      # Create a minimal sys/capability.h shim.
      # The real sys/capability.h comes from libcap. bwrap uses both
      # raw kernel types (capget/capset) and libcap types (cap_value_t,
      # cap_from_name). We provide the kernel header + stubs for the
      # libcap types.
      mkdir -p sys
      cat > sys/capability.h << 'CAPEOF'
#ifndef _SYS_CAPABILITY_H
#define _SYS_CAPABILITY_H
#include <linux/capability.h>
typedef int cap_value_t;
/* Stub: cap_from_name is only used for --cap-add/--cap-drop parsing.
 * Return -1 (not found) so the feature gracefully degrades. */
static inline int cap_from_name(const char *name __attribute__((unused)),
                                cap_value_t *cap __attribute__((unused))) {
    return -1;
}
#define cap_valid(x) ((x) >= 0 && (x) <= __CAP_BITS)
#endif
CAPEOF

      echo "Compiling bubblewrap..."
      gcc -static -Os -pipe \
        -D_GNU_SOURCE \
        -I. \
        -o bwrap \
        bubblewrap.c bind-mount.c network.c utils.c \
        || { echo "ERROR: bwrap compilation failed" >&2; exit 1; }

      if [ ! -f bwrap ]; then
        echo "ERROR: bwrap binary not found after build" >&2
        exit 1
      fi

      # Install.
      mkdir -p $out/bin
      cp bwrap $out/bin/bwrap
      chmod +x $out/bin/bwrap

      # Verify.
      echo "Verifying bwrap..."
      $out/bin/bwrap --version
      echo "Bwrap build complete: $out/bin/bwrap"
    "%
  ],
  system = "x86_64-linux",
  inputs = [toolchain, binutils, musl, gcc, bwrap_src],
}

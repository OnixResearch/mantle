# Build gzip 1.2.4 using tinycc 0.9.27 + make 3.82.
#
# gzip is needed to decompress .tar.gz source archives in the chain.
# Adapted from live-bootstrap steps/gzip-1.2.4/pass1.kaem.
#
# The build needs a CRC table generated by sample/makecrc.c.
# We compile makecrc with tcc, run it to produce crc.c, then
# prepend it to util.c before the main build.

let crunch = import "lib.ncl" in

let stage0 = import "stage0-posix.ncl" in
let tcc = import "tinycc.ncl" in

let gzip_src = crunch.fetchTarball {
  # provenance: fosslinux/live-bootstrap parts.rst labels this point `gzip 1.2.5`,
  # but the implemented step is steps/gzip-1.2.4/sources.
  # first-consumer: bootstrap/gzip-tcc.ncl
  url = "https://ftpmirror.gnu.org/gzip/gzip-1.2.4.tar.gz",
  hash = "sha256-s2cf/BeNFNWkTRjMvJU2F9PKGNrLwxWK3RtK67AcXNo=",
  name = "gzip-1.2.4-src",
} in

{
  name = "gzip-1.2.4-tcc",
  builder = "/bin/sh",
  args = [
    "-c",
    m%"
      set -eu
      BB=/bin/busybox

      find_input() {
        for d in $NIX_STORE/*-"$1"; do
          if [ -d "$d" ]; then echo "$d"; return; fi
        done
        echo "ERROR: input $1 not found" >&2; exit 1
      }

      TCC=$(find_input tinycc-0.9.27)
      STAGE0=$(find_input stage0-posix)
      GZIP_SRC=$(find_input gzip-1.2.4-src)

      export PATH="$TCC/bin:$STAGE0/bin:$PATH"

      WORK=/tmp/gzip-build
      $BB mkdir -p "$WORK"
      cd "$WORK"

      # fetchTarball strips single top-level dir
      $BB cp -r "$GZIP_SRC" gzip-1.2.4
      $BB chmod -R u+w gzip-1.2.4
      cd gzip-1.2.4

      # Mes stat headers already expose the st_atime/st_mtime/st_ctime field
      # names expected by gzip 1.2.4 on this TinyCC handoff.

      # Generate CRC table: compile makecrc, run it to produce crc.c,
      # then append crc.c to util.c.
      # First, strip the generated crc_32_tab from util.c (between markers)
      $BB sed -i '/^ulg crc_32_tab/,/^};/d' util.c

      # Patch makecrc to write to a file instead of stdout
      # (IO redirection may not be available in all shells)
      $BB cat > /tmp/makecrc_patch.c << 'MKPATCH'
/* Minimal makecrc that writes crc.c file */
#include <stdio.h>
typedef unsigned long ulg;
int main() {
    ulg c, poly;
    int n, k;
    FILE *f = fopen("crc.c", "w");
    if (!f) return 1;
    fprintf(f, "ulg crc_32_tab[] = {\n");
    for (n = 0; n < 256; n++) {
        c = (ulg)n;
        for (k = 0; k < 8; k++) {
            if (c & 1) c = 0xedb88320L ^ (c >> 1);
            else c = c >> 1;
        }
        if (n % 4 == 3) fprintf(f, "  0x%08lxL,\n", c);
        else fprintf(f, "  0x%08lxL, ", c);
    }
    fprintf(f, "};\n");
    fclose(f);
    return 0;
}
MKPATCH
      tcc -static -o makecrc /tmp/makecrc_patch.c
      ./makecrc
      test -s crc.c || { echo "ERROR: makecrc did not produce crc.c" >&2; exit 1; }
      $BB cat util.c crc.c > util.c.new
      $BB mv util.c.new util.c

      # Compile all sources
      CFLAGS="-I. -DNO_UTIME -Dstrlwr=unused"
      OBJS=""
      for src in gzip bits crypt deflate getopt inflate lzw trees \
                 unlzh unlzw unpack unzip util zip; do
        obj="$src.o"
        tcc -c $CFLAGS $src.c -o "$obj"
        test -f "$obj" || { echo "ERROR: missing object $obj" >&2; exit 1; }
        OBJS="$OBJS $obj"
      done
      test -n "$OBJS" || { echo "ERROR: no gzip objects compiled" >&2; exit 1; }

      # Link
      tcc -static $OBJS -o gzip
      $BB chmod 755 gzip

      # Verify
      ./gzip --help >/dev/null

      # Install
      $BB mkdir -p "$out/bin"
      $BB cp gzip "$out/bin/gzip"
      $BB cp gzip "$out/bin/gunzip"
      $BB chmod 755 "$out/bin/gzip" "$out/bin/gunzip"

      test -x "$out/bin/gzip" || { echo "ERROR: gzip output missing" >&2; exit 1; }
      test -x "$out/bin/gunzip" || { echo "ERROR: gunzip output missing" >&2; exit 1; }
      "$out/bin/gzip" --help >/dev/null
      "$out/bin/gunzip" --help >/dev/null
      $BB printf 'gzip smoke\n' > /tmp/gzip-smoke.txt
      "$out/bin/gzip" -c /tmp/gzip-smoke.txt > /tmp/gzip-smoke.txt.gz
      test -s /tmp/gzip-smoke.txt.gz || { echo "ERROR: gzip smoke archive missing" >&2; exit 1; }
      "$out/bin/gunzip" -c /tmp/gzip-smoke.txt.gz > /tmp/gzip-smoke.out
      $BB cmp /tmp/gzip-smoke.txt /tmp/gzip-smoke.out >/dev/null || { echo "ERROR: gzip roundtrip mismatch" >&2; exit 1; }
    "%,
  ],
  inputs = [stage0, tcc, gzip_src],
} | crunch.Derivation

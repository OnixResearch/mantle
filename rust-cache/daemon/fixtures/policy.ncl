let Contracts = import "../contracts.ncl" in
{
  schema = "mantle-rustc-wrapper-policy-v1",
  policy_id = "developer-local-v1",
  cache_mode = "local-read-write",
  failure_mode = "fail-open",
  socket_path = "/run/user/1000/mantle-rust-cache.sock",
  allowed_peer_uids = [1000],
  readable_roots = ["/home/operator/source", "/toolchain"],
  writable_roots = ["/home/operator/source/target"],
  allowed_environment = ["CARGO_CFG_TARGET_ARCH", "PATH"],
  effects = {
    filesystem = "declared-roots",
    network = "deny",
    clock = "allow",
    randomness = "allow",
  },
  limits = {
    elapsed_millis = 300000,
    stdout_bytes = 1048576,
    stderr_bytes = 1048576,
    artifact_bytes = 8589934592,
  },
  max_request_bytes = 8388608,
  max_response_bytes = 8388608,
  max_concurrency = 8,
  sandbox_program = "/usr/bin/bwrap",
  sandbox_program_blake3 = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  result_sources = [],
  shared_trust_policy = null,
  publication = {
    enabled = false,
    source_id = null,
    signer_name = null,
    signing_key_path = null,
  },
  local_reads_enabled = true,
  local_writes_enabled = true,
  shared_reads_enabled = false,
  shared_writes_enabled = false,
  redact_environment_values = true,
} | Contracts.Policy

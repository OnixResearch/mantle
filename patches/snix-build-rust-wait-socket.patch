+        {
+            return Err(std::io::Error::other("Rust wait socket path must be a bounded clean absolute path"));
+        }
+        rust_wait_socket_mount(&host_socket)?;
+        self.rust_wait_socket = Some(host_socket);
         Ok(self)
     }
 

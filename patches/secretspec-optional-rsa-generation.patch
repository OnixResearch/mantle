From a8794e46ec9664a0e1a3869cc3105d0853937e48 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Make RSA key generation opt-out for non-generating clients

For the exact published secretspec 0.17.0 package only. Keep RSA generation
in the default feature set for existing consumers; allow the no-default
SOPS resolver to exclude the vulnerable rsa crate. Reject disabled RSA
configuration explicitly instead of silently choosing another generator.

--- a/Cargo.toml
+++ b/Cargo.toml
@@ -52,6 +52,7 @@
     "age",
     "scaleway",
     "sops",
+    "rsa-generation",
 ]
 gcsm = ["dep:google-cloud-secretmanager-v1"]
 infisical = [
@@ -64,6 +65,7 @@
     "dep:whoami",
 ]
 openbao = ["dep:reqwest"]
+rsa-generation = ["dep:rsa"]
 scaleway = ["dep:reqwest"]
 sops = []
 vault = ["dep:reqwest"]
@@ -183,6 +185,7 @@
 [dependencies.rsa]
 version = "0.9"
 features = ["pem"]
+optional = true
 
 [dependencies.secrecy]
 version = "0.10.3"
--- a/src/config.rs
+++ b/src/config.rs
@@ -1954,7 +1954,9 @@
             // Validate known types
             if let Some(ref t) = self.secret_type {
                 match t.as_str() {
-                    "password" | "hex" | "base64" | "uuid" | "command" | "rsa_private_key" => {}
+                    "password" | "hex" | "base64" | "uuid" | "command" => {}
+                    #[cfg(feature = "rsa-generation")]
+                    "rsa_private_key" => {}
                     unknown => {
                         return Err(format!("unknown secret type '{}'", unknown));
                     }
@@ -1968,7 +1970,9 @@
         {
             // Type is informational when not generating, but still validate known values
             match t.as_str() {
-                "password" | "hex" | "base64" | "uuid" | "command" | "rsa_private_key" => {}
+                "password" | "hex" | "base64" | "uuid" | "command" => {}
+                #[cfg(feature = "rsa-generation")]
+                "rsa_private_key" => {}
                 unknown => {
                     return Err(format!("unknown secret type '{}'", unknown));
                 }

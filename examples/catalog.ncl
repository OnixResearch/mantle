# Mantle examples support catalog.
#
# This is the source of truth for example documentation and validation rails.
# Keep entries declarative: tests consume this file to reject stale docs,
# duplicate paths, silent skips, and unsupported tier names.

let Rail = String in
let RequirementFlags = {
  network | Bool,
  generated_seed | Bool,
  linux_bwrap | Bool,
  heavyweight | Bool,
  benchmark | Bool,

diag-insn-modes-head: insn-modes.h:018   TFmode,
diag-insn-modes-head: insn-modes.h:019   MAX_MACHINE_MODE,
diag-insn-modes-head: insn-modes.h:020   NUM_MACHINE_MODES = MAX_MACHINE_MODE

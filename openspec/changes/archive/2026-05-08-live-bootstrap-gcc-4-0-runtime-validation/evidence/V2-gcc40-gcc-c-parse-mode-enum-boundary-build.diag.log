diag-tree-head: 001 /* Front-end tree definitions for GNU compiler.
diag-tree-head: 002    Copyright (C) 1989, 1993, 1994, 1995, 1996, 1997, 1998, 1999, 2000,
diag-tree-head: 003    2001, 2002, 2003, 2004, 2005 Free Software Foundation, Inc.
diag-tree-head: 004
diag-tree-head: 005 This file is part of GCC.
diag-tree-head: 006
diag-tree-head: 007 GCC is free software; you can redistribute it and/or modify it under
diag-tree-head: 008 the terms of the GNU General Public License as published by the Free
diag-tree-head: 009 Software Foundation; either version 2, or (at your option) any later
diag-tree-head: 010 version.
diag-tree-head: 011
diag-tree-head: 012 GCC is distributed in the hope that it will be useful, but WITHOUT ANY
diag-tree-head: 013 WARRANTY; without even the implied warranty of MERCHANTABILITY or
diag-tree-head: 014 FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
diag-tree-head: 015 for more details.
diag-tree-head: 016
diag-tree-head: 017 You should have received a copy of the GNU General Public License
diag-tree-head: 018 along with GCC; see the file COPYING.  If not, write to the Free
diag-tree-head: 019 Software Foundation, 59 Temple Place - Suite 330, Boston, MA
diag-tree-head: 020 02111-1307, USA.  */
diag-tree-head: 021
diag-tree-head: 022 #ifndef GCC_TREE_H
diag-tree-head: 023 #define GCC_TREE_H
diag-tree-head: 024
diag-tree-head: 025 #include "machmode.h"
diag-tree-head: 026 #include "input.h"
diag-tree-head: 027 #include "statistics.h"
diag-tree-head: 028 #include "vec.h"
diag-tree-head: 029
diag-tree-head: 030 /* Codes of tree nodes */
diag-tree-head: 031
diag-tree-head: 032 #define DEFTREECODE(SYM, STRING, TYPE, NARGS)   SYM,
diag-tree-head: 033
diag-tree-head: 034 enum tree_code {
diag-tree-head: 035 #include "tree.def"
diag-tree-head: 036
diag-tree-head: 037   LAST_AND_UNUSED_TREE_CODE	/* A convenient way to get a value for
diag-tree-head: 038 				   NUM_TREE_CODES.  */
diag-tree-head: 039 };
diag-tree-head: 040
diag-tree-head: 041 #undef DEFTREECODE
diag-tree-head: 042
diag-tree-head: 043 /* Number of language-independent tree codes.  */
diag-tree-head: 044 #define NUM_TREE_CODES ((int) LAST_AND_UNUSED_TREE_CODE)
diag-tree-head: 045
diag-tree-head: 046 /* Tree code classes.  */
diag-tree-head: 047
diag-tree-head: 048 /* Each tree_code has an associated code class represented by a
diag-tree-head: 049    TREE_CODE_CLASS.  */
diag-tree-head: 050
diag-tree-head: 051 enum tree_code_class {
diag-tree-head: 052   tcc_exceptional, /* An exceptional code (fits no category).  */
diag-tree-head: 053   tcc_constant,    /* A constant.  */
diag-tree-head: 054   /* Order of tcc_type and tcc_declaration is important.  */
diag-tree-head: 055   tcc_type,        /* A type object code.  */
diag-tree-head: 056   tcc_declaration, /* A declaration (also serving as variable refs).  */
diag-tree-head: 057   tcc_reference,   /* A reference to storage.  */
diag-tree-head: 058   tcc_comparison,  /* A comparison expression.  */
diag-tree-head: 059   tcc_unary,       /* A unary arithmetic expression.  */
diag-tree-head: 060   tcc_binary,      /* A binary arithmetic expression.  */
diag-tree-head: 061   tcc_statement,   /* A statement expression, which have side effects
diag-tree-head: 062 		      but usually no interesting value.  */
diag-tree-head: 063   tcc_expression   /* Any other expression.  */
diag-tree-head: 064 };
diag-tree-head: 065
diag-tree-head: 066 /* Each tree code class has an associated string representation.
diag-tree-head: 067    These must correspond to the tree_code_class entries.  */
diag-tree-head: 068
diag-tree-head: 069 extern const char *const tree_code_class_strings[];
diag-tree-head: 070
diag-tree-head: 071 /* Returns the string representing CLASS.  */
diag-tree-head: 072
diag-tree-head: 073 #define TREE_CODE_CLASS_STRING(CLASS)\
diag-tree-head: 074         tree_code_class_strings[(int) (CLASS)]
diag-tree-head: 075
diag-tree-head: 076 #define MAX_TREE_CODES 256
diag-tree-head: 077 extern const enum tree_code_class tree_code_type[];
diag-tree-head: 078 #define TREE_CODE_CLASS(CODE)	tree_code_type[(int) (CODE)]
diag-tree-head: 079
diag-tree-head: 080 /* Nonzero if CODE represents an exceptional code.  */
diag-tree-head: 081
diag-tree-head: 082 #define EXCEPTIONAL_CLASS_P(CODE)\
diag-tree-head: 083 	(TREE_CODE_CLASS (TREE_CODE (CODE)) == tcc_exceptional)
diag-tree-head: 084
diag-tree-head: 085 /* Nonzero if CODE represents a constant.  */
diag-tree-head: 086
diag-tree-head: 087 #define CONSTANT_CLASS_P(CODE)\
diag-tree-head: 088 	(TREE_CODE_CLASS (TREE_CODE (CODE)) == tcc_constant)
diag-tree-head: 089
diag-tree-head: 090 /* Nonzero if CODE represents a type.  */
diag-tree-head: 091
diag-tree-head: 092 #define TYPE_P(CODE)\
diag-tree-head: 093 	(TREE_CODE_CLASS (TREE_CODE (CODE)) == tcc_type)
diag-tree-head: 094
diag-tree-head: 095 /* Nonzero if CODE represents a declaration.  */
diag-tree-head: 096
diag-tree-head: 097 #define DECL_P(CODE)\
diag-tree-head: 098         (TREE_CODE_CLASS (TREE_CODE (CODE)) == tcc_declaration)
diag-tree-head: 099
diag-tree-head: 100 /* Nonzero if CODE represents a INDIRECT_REF.  Keep these checks in
diag-tree-head: 101    ascending code order.  */
diag-tree-head: 102 #define INDIRECT_REF_P(CODE)\
diag-tree-head: 103   (TREE_CODE (CODE) == INDIRECT_REF \
diag-tree-head: 104    || TREE_CODE (CODE) == ALIGN_INDIRECT_REF \
diag-tree-head: 105    || TREE_CODE (CODE) == MISALIGNED_INDIRECT_REF)
diag-tree-head: 106
diag-tree-head: 107 /* Nonzero if CODE represents a reference.  */
diag-tree-head: 108
diag-tree-head: 109 #define REFERENCE_CLASS_P(CODE)\
diag-tree-head: 110 	(TREE_CODE_CLASS (TREE_CODE (CODE)) == tcc_reference)
diag-tree-head: 111
diag-tree-head: 112 /* Nonzero if CODE represents a comparison.  */
diag-tree-head: 113
diag-tree-head: 114 #define COMPARISON_CLASS_P(CODE)\
diag-tree-head: 115 	(TREE_CODE_CLASS (TREE_CODE (CODE)) == tcc_comparison)
diag-tree-head: 116
diag-tree-head: 117 /* Nonzero if CODE represents a unary arithmetic expression.  */
diag-tree-head: 118
diag-tree-head: 119 #define UNARY_CLASS_P(CODE)\
diag-tree-head: 120 	(TREE_CODE_CLASS (TREE_CODE (CODE)) == tcc_unary)
diag-tree-head: 121
diag-tree-head: 122 /* Nonzero if CODE represents a binary arithmetic expression.  */
diag-tree-head: 123
diag-tree-head: 124 #define BINARY_CLASS_P(CODE)\
diag-tree-head: 125 	(TREE_CODE_CLASS (TREE_CODE (CODE)) == tcc_binary)
diag-tree-head: 126
diag-tree-head: 127 /* Nonzero if CODE represents a statement expression.  */
diag-tree-head: 128
diag-tree-head: 129 #define STATEMENT_CLASS_P(CODE)\
diag-tree-head: 130 	(TREE_CODE_CLASS (TREE_CODE (CODE)) == tcc_statement)
diag-tree-head: 131
diag-tree-head: 132 /* Nonzero if CODE represents any other expression.  */
diag-tree-head: 133
diag-tree-head: 134 #define EXPRESSION_CLASS_P(CODE)\
diag-tree-head: 135 	(TREE_CODE_CLASS (TREE_CODE (CODE)) == tcc_expression)
diag-tree-head: 136
diag-tree-head: 137 /* Returns nonzero iff CLASS is not the tree code of a type.  */
diag-tree-head: 138
diag-tree-head: 139 #define IS_NON_TYPE_CODE_CLASS(CLASS) ((CLASS) != tcc_type)
diag-tree-head: 140
diag-tree-head: 141 /* Returns nonzero iff CODE represents a type or declaration.  */
diag-tree-head: 142
diag-tree-head: 143 #define IS_TYPE_OR_DECL_P(CODE)\
diag-tree-head: 144 	(TYPE_P (CODE) || DECL_P (CODE))
diag-tree-head: 145
diag-tree-head: 146 /* Returns nonzero iff CLASS is the tree-code class of an
diag-tree-head: 147    expression.  */
diag-tree-head: 148
diag-tree-head: 149 #define IS_EXPR_CODE_CLASS(CLASS)\
diag-tree-head: 150 	((CLASS) >= tcc_reference && (CLASS) <= tcc_expression)
diag-tree-head: 151
diag-tree-head: 152 /* Returns nonzero iff NODE is an expression of some kind.  */
diag-tree-head: 153
diag-tree-head: 154 #define EXPR_P(NODE) IS_EXPR_CODE_CLASS (TREE_CODE_CLASS (TREE_CODE (NODE)))
diag-tree-head: 155
diag-tree-head: 156 /* Number of argument-words in each kind of tree-node.  */
diag-tree-head: 157
diag-tree-head: 158 extern const unsigned char tree_code_length[];
diag-tree-head: 159 #define TREE_CODE_LENGTH(CODE)	tree_code_length[(int) (CODE)]
diag-tree-head: 160
diag-tree-head: 161 /* Names of tree components.  */
diag-tree-head: 162
diag-tree-head: 163 extern const char *const tree_code_name[];
diag-tree-head: 164
diag-tree-head: 165 /* A garbage collected vector of trees.  */
diag-tree-head: 166 DEF_VEC_GC_P(tree);
diag-tree-head: 167
diag-tree-head: 168

diag-tree-head: 169 /* Classify which part of the compiler has defined a given builtin function.
diag-tree-head: 170    Note that we assume below that this is no more than two bits.  */
diag-tree-head: 171 enum built_in_class
diag-tree-head: 172 {
diag-tree-head: 173   NOT_BUILT_IN = 0,
diag-tree-head: 174   BUILT_IN_FRONTEND,
diag-tree-head: 175   BUILT_IN_MD,
diag-tree-head: 176   BUILT_IN_NORMAL
diag-tree-head: 177 };
diag-tree-head: 178
diag-tree-head: 179 /* Names for the above.  */
diag-tree-head: 180 extern const char *const built_in_class_names[4];
diag-tree-head: 181
diag-tree-head: 182 /* Codes that identify the various built in functions
diag-tree-head: 183    so that expand_call can identify them quickly.  */
diag-tree-head: 184
diag-tree-head: 185 #define DEF_BUILTIN(ENUM, N, C, T, LT, B, F, NA, AT, IM, COND) ENUM,
diag-tree-head: 186 enum built_in_function
diag-tree-head: 187 {
diag-tree-head: 188 #include "builtins.def"
diag-tree-head: 189
diag-tree-head: 190   /* Complex division routines in libgcc.  These are done via builtins
diag-tree-head: 191      because emit_library_call_value can't handle complex values.  */
diag-tree-head: 192   BUILT_IN_COMPLEX_MUL_MIN,
diag-tree-head: 193   BUILT_IN_COMPLEX_MUL_MAX
diag-tree-head: 194     = BUILT_IN_COMPLEX_MUL_MIN
diag-tree-head: 195       + MAX_MODE_COMPLEX_FLOAT
diag-tree-head: 196       - MIN_MODE_COMPLEX_FLOAT,
diag-tree-head: 197
diag-tree-head: 198   BUILT_IN_COMPLEX_DIV_MIN,
diag-tree-head: 199   BUILT_IN_COMPLEX_DIV_MAX
diag-tree-head: 200     = BUILT_IN_COMPLEX_DIV_MIN
diag-tree-head: 201       + MAX_MODE_COMPLEX_FLOAT
diag-tree-head: 202       - MIN_MODE_COMPLEX_FLOAT,
diag-tree-head: 203
diag-tree-head: 204   /* Upper bound on non-language-specific builtins.  */
diag-tree-head: 205   END_BUILTINS
diag-tree-head: 206 };
diag-tree-head: 207 #undef DEF_BUILTIN
diag-tree-head: 208
diag-tree-head: 209 /* Names for the above.  */
diag-tree-head: 210 extern const char * built_in_names[(int) END_BUILTINS];
diag-tree-head: 211
diag-tree-head: 212 /* Helper macros for math builtins.  */
diag-tree-head: 213
diag-tree-head: 214 #define BUILTIN_EXP10_P(FN) \
diag-tree-head: 215  ((FN) == BUILT_IN_EXP10 || (FN) == BUILT_IN_EXP10F || (FN) == BUILT_IN_EXP10L \
diag-tree-head: 216   || (FN) == BUILT_IN_POW10 || (FN) == BUILT_IN_POW10F || (FN) == BUILT_IN_POW10L)
diag-tree-head: 217
diag-tree-head: 218 #define BUILTIN_EXPONENT_P(FN) (BUILTIN_EXP10_P (FN) \
diag-tree-head: 219   || (FN) == BUILT_IN_EXP || (FN) == BUILT_IN_EXPF || (FN) == BUILT_IN_EXPL \
diag-tree-head: 220   || (FN) == BUILT_IN_EXP2 || (FN) == BUILT_IN_EXP2F || (FN) == BUILT_IN_EXP2L)

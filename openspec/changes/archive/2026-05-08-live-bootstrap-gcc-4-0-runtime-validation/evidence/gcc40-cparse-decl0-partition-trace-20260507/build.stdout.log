diag-insn-modes-head: insn-modes.h:004 #define CONST_MODE_BASE_ALIGN const
diag-insn-modes-head: insn-modes.h:005 enum machine_mode {
diag-insn-modes-head: insn-modes.h:006   VOIDmode,
diag-insn-modes-head: insn-modes.h:007   BLKmode,
diag-insn-modes-head: insn-modes.h:008   CCmode,
diag-insn-modes-head: insn-modes.h:009   BImode,
diag-insn-modes-head: insn-modes.h:010   QImode,
diag-insn-modes-head: insn-modes.h:011   HImode,
diag-insn-modes-head: insn-modes.h:012   SImode,
diag-insn-modes-head: insn-modes.h:013   DImode,
diag-insn-modes-head: insn-modes.h:014   TImode,
diag-insn-modes-head: insn-modes.h:015   SFmode,
diag-insn-modes-head: insn-modes.h:016   DFmode,
diag-insn-modes-head: insn-modes.h:017   XFmode,

diag-machmode-head: 007 GCC is free software; you can redistribute it and/or modify it under
diag-machmode-head: 008 the terms of the GNU General Public License as published by the Free
diag-machmode-head: 009 Software Foundation; either version 2, or (at your option) any later
diag-machmode-head: 010 version.
diag-machmode-head: 011
diag-machmode-head: 012 GCC is distributed in the hope that it will be useful, but WITHOUT ANY
diag-machmode-head: 013 WARRANTY; without even the implied warranty of MERCHANTABILITY or
diag-machmode-head: 014 FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
diag-machmode-head: 015 for more details.
diag-machmode-head: 016
diag-machmode-head: 017 You should have received a copy of the GNU General Public License
diag-machmode-head: 018 along with GCC; see the file COPYING.  If not, write to the Free
diag-machmode-head: 019 Software Foundation, 59 Temple Place - Suite 330, Boston, MA
diag-machmode-head: 020 02111-1307, USA.  */
diag-machmode-head: 021
diag-machmode-head: 022 #ifndef HAVE_MACHINE_MODES
diag-machmode-head: 023 #define HAVE_MACHINE_MODES
diag-machmode-head: 024
diag-machmode-head: 025 /* Make an enum class that gives all the machine modes.  */
diag-machmode-head: 026 #include "insn-modes.h"
diag-machmode-head: 027
diag-machmode-head: 028 /* Get the name of mode MODE as a string.  */
diag-machmode-head: 029
diag-machmode-head: 030 extern const char * const mode_name[NUM_MACHINE_MODES];
diag-machmode-head: 031 #define GET_MODE_NAME(MODE)  mode_name[MODE]
diag-machmode-head: 032
diag-machmode-head: 033 /* Mode classes.  */
diag-machmode-head: 034
diag-machmode-head: 035 #include "mode-classes.def"
diag-machmode-head: 036 #define DEF_MODE_CLASS(M) M
diag-machmode-head: 037 enum mode_class { MODE_CLASSES, MAX_MODE_CLASS };
diag-machmode-head: 038 #undef DEF_MODE_CLASS
diag-machmode-head: 039 #undef MODE_CLASSES
diag-machmode-head: 040
diag-machmode-head: 041 /* Get the general kind of object that mode MODE represents
diag-machmode-head: 042    (integer, floating, complex, etc.)  */
diag-machmode-head: 043
diag-machmode-head: 044 extern const unsigned char mode_class[NUM_MACHINE_MODES];
diag-machmode-head: 045 #define GET_MODE_CLASS(MODE)  mode_class[MODE]
diag-machmode-head: 046
diag-machmode-head: 047 /* Nonzero if MODE is an integral mode.  */
diag-machmode-head: 048 #define INTEGRAL_MODE_P(MODE)			\
diag-machmode-head: 049   (GET_MODE_CLASS (MODE) == MODE_INT		\
diag-machmode-head: 050    || GET_MODE_CLASS (MODE) == MODE_PARTIAL_INT \
diag-machmode-head: 051    || GET_MODE_CLASS (MODE) == MODE_COMPLEX_INT \
diag-machmode-head: 052    || GET_MODE_CLASS (MODE) == MODE_VECTOR_INT)
diag-machmode-head: 053
diag-machmode-head: 054 /* Nonzero if MODE is a floating-point mode.  */
diag-machmode-head: 055 #define FLOAT_MODE_P(MODE)		\
diag-machmode-head: 056   (GET_MODE_CLASS (MODE) == MODE_FLOAT	\
diag-machmode-head: 057    || GET_MODE_CLASS (MODE) == MODE_COMPLEX_FLOAT \
diag-machmode-head: 058    || GET_MODE_CLASS (MODE) == MODE_VECTOR_FLOAT)
diag-machmode-head: 059
diag-machmode-head: 060 /* Nonzero if MODE is a complex mode.  */
diag-machmode-head: 061 #define COMPLEX_MODE_P(MODE)			\
diag-machmode-head: 062   (GET_MODE_CLASS (MODE) == MODE_COMPLEX_INT	\
diag-machmode-head: 063    || GET_MODE_CLASS (MODE) == MODE_COMPLEX_FLOAT)
diag-machmode-head: 064
diag-machmode-head: 065 /* Nonzero if MODE is a vector mode.  */
diag-machmode-head: 066 #define VECTOR_MODE_P(MODE)			\
diag-machmode-head: 067   (GET_MODE_CLASS (MODE) == MODE_VECTOR_INT	\
diag-machmode-head: 068    || GET_MODE_CLASS (MODE) == MODE_VECTOR_FLOAT)
diag-machmode-head: 069
diag-machmode-head: 070 /* Nonzero if MODE is a scalar integral mode.  */
diag-machmode-head: 071 #define SCALAR_INT_MODE_P(MODE)			\
diag-machmode-head: 072   (GET_MODE_CLASS (MODE) == MODE_INT		\
diag-machmode-head: 073    || GET_MODE_CLASS (MODE) == MODE_PARTIAL_INT)
diag-machmode-head: 074
diag-machmode-head: 075 /* Nonzero if MODE is a scalar floating point mode.  */
diag-machmode-head: 076 #define SCALAR_FLOAT_MODE_P(MODE)		\
diag-machmode-head: 077   (GET_MODE_CLASS (MODE) == MODE_FLOAT)
diag-machmode-head: 078
diag-machmode-head: 079 /* Get the size in bytes and bits of an object of mode MODE.  */
diag-machmode-head: 080
diag-machmode-head: 081 extern CONST_MODE_SIZE unsigned char mode_size[NUM_MACHINE_MODES];
diag-machmode-head: 082 #define GET_MODE_SIZE(MODE)    ((unsigned short) mode_size[MODE])
diag-machmode-head: 083 #define GET_MODE_BITSIZE(MODE) ((unsigned short) (GET_MODE_SIZE (MODE) * BITS_PER_UNIT))
diag-machmode-head: 084
diag-machmode-head: 085 /* Get the number of value bits of an object of mode MODE.  */
diag-machmode-head: 086 extern const unsigned short mode_precision[NUM_MACHINE_MODES];
diag-machmode-head: 087 #define GET_MODE_PRECISION(MODE)  mode_precision[MODE]
diag-machmode-head: 088
diag-machmode-head: 089 /* Get a bitmask containing 1 for all bits in a word
diag-machmode-head: 090    that fit within mode MODE.  */
diag-machmode-head: 091
diag-machmode-head: 092 extern const unsigned HOST_WIDE_INT mode_mask_array[NUM_MACHINE_MODES];
diag-machmode-head: 093
diag-machmode-head: 094 #define GET_MODE_MASK(MODE) mode_mask_array[MODE]
diag-machmode-head: 095
diag-machmode-head: 096 /* Return the mode of the inner elements in a vector.  */
diag-machmode-head: 097
diag-machmode-head: 098 extern const unsigned char mode_inner[NUM_MACHINE_MODES];
diag-machmode-head: 099 #define GET_MODE_INNER(MODE) mode_inner[MODE]
diag-machmode-head: 100
diag-machmode-head: 101 /* Get the size in bytes of the basic parts of an object of mode MODE.  */
diag-machmode-head: 102
diag-machmode-head: 103 #define GET_MODE_UNIT_SIZE(MODE)		\
diag-machmode-head: 104   (GET_MODE_INNER (MODE) == VOIDmode		\
diag-machmode-head: 105    ? GET_MODE_SIZE (MODE)			\
diag-machmode-head: 106    : GET_MODE_SIZE (GET_MODE_INNER (MODE)))
diag-machmode-head: 107
diag-machmode-head: 108 /* Get the number of units in the object.  */
diag-machmode-head: 109
diag-machmode-head: 110 extern const unsigned char mode_nunits[NUM_MACHINE_MODES];
diag-machmode-head: 111 #define GET_MODE_NUNITS(MODE)  mode_nunits[MODE]
diag-machmode-head: 112
diag-machmode-head: 113 /* Get the next wider natural mode (eg, QI -> HI -> SI -> DI -> TI).  */
diag-machmode-head: 114
diag-machmode-head: 115 extern const unsigned char mode_wider[NUM_MACHINE_MODES];
diag-machmode-head: 116 #define GET_MODE_WIDER_MODE(MODE) mode_wider[MODE]
diag-machmode-head: 117
diag-machmode-head: 118 /* Return the mode for data of a given size SIZE and mode class CLASS.
diag-machmode-head: 119    If LIMIT is nonzero, then don't use modes bigger than MAX_FIXED_MODE_SIZE.
diag-machmode-head: 120    The value is BLKmode if no other mode is found.  */
diag-machmode-head: 121
diag-machmode-head: 122 extern enum machine_mode mode_for_size (unsigned int, enum mode_class, int);
diag-machmode-head: 123
diag-machmode-head: 124 /* Similar, but find the smallest mode for a given width.  */
diag-machmode-head: 125
diag-machmode-head: 126 extern enum machine_mode smallest_mode_for_size (unsigned int,
diag-machmode-head: 127 						 enum mode_class);
diag-machmode-head: 128
diag-machmode-head: 129
diag-machmode-head: 130 /* Return an integer mode of the exact same size as the input mode,
diag-machmode-head: 131    or BLKmode on failure.  */
diag-machmode-head: 132
diag-machmode-head: 133 extern enum machine_mode int_mode_for_mode (enum machine_mode);
diag-machmode-head: 134
diag-machmode-head: 135 /* Find the best mode to use to access a bit field.  */
diag-machmode-head: 136
diag-machmode-head: 137 extern enum machine_mode get_best_mode (int, int, unsigned int,
diag-machmode-head: 138 					enum machine_mode, int);
diag-machmode-head: 139
diag-machmode-head: 140 /* Determine alignment, 1<=result<=BIGGEST_ALIGNMENT.  */
diag-cparse: compile cparse_undef6_machmode_guard_only
diag-cparse: cparse_undef6_machmode_guard_only rc=0

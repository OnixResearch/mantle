diag-machmode-head: 001 /* Machine mode definitions for GCC; included by rtl.h and tree.h.
diag-machmode-head: 002    Copyright (C) 1991, 1993, 1994, 1996, 1998, 1999, 2000, 2001, 2003
diag-machmode-head: 003    Free Software Foundation, Inc.

diag-flags-head: 028 enum debug_info_type
diag-flags-head: 029 {
diag-flags-head: 030   NO_DEBUG,	    /* Write no debug info.  */
diag-flags-head: 031   DBX_DEBUG,	    /* Write BSD .stabs for DBX (using dbxout.c).  */
diag-flags-head: 032   SDB_DEBUG,	    /* Write COFF for (old) SDB (using sdbout.c).  */
diag-flags-head: 033   DWARF2_DEBUG,	    /* Write Dwarf v2 debug info (using dwarf2out.c).  */
diag-flags-head: 034   XCOFF_DEBUG,	    /* Write IBM/Xcoff debug info (using dbxout.c).  */
diag-flags-head: 035   VMS_DEBUG,        /* Write VMS debug info (using vmsdbgout.c).  */
diag-flags-head: 036   VMS_AND_DWARF2_DEBUG /* Write VMS debug info (using vmsdbgout.c).
diag-flags-head: 037                           and DWARF v2 debug info (using dwarf2out.c).  */
diag-flags-head: 038 };
diag-flags-head: 039
diag-flags-head: 040 /* Specify which kind of debugging info to generate.  */
diag-flags-head: 041 extern enum debug_info_type write_symbols;
diag-flags-head: 042
diag-flags-head: 043 /* Names of debug_info_type, for error messages.  */
diag-flags-head: 044 extern const char *const debug_type_names[];
diag-flags-head: 045
diag-flags-head: 046 enum debug_info_level
diag-flags-head: 047 {
diag-flags-head: 048   DINFO_LEVEL_NONE,	/* Write no debugging info.  */
diag-flags-head: 049   DINFO_LEVEL_TERSE,	/* Write minimal info to support tracebacks only.  */
diag-flags-head: 050   DINFO_LEVEL_NORMAL,	/* Write info for all declarations (and line table).  */
diag-flags-head: 051   DINFO_LEVEL_VERBOSE	/* Write normal info plus #define/#undef info.  */
diag-flags-head: 052 };
diag-flags-head: 053
diag-flags-head: 054 /* Specify how much debugging info to generate.  */
diag-flags-head: 055 extern enum debug_info_level debug_info_level;
diag-flags-head: 056
diag-flags-head: 057 /* Nonzero means use GNU-only extensions in the generated symbolic
diag-flags-head: 058    debugging information.  */
diag-flags-head: 059 extern bool use_gnu_debug_info_extensions;
diag-flags-head: 060
diag-flags-head: 061 /* Enumerate visibility settings.  */
diag-flags-head: 062 #ifndef SYMBOL_VISIBILITY_DEFINED
diag-flags-head: 063 #define SYMBOL_VISIBILITY_DEFINED
diag-flags-head: 064 enum symbol_visibility
diag-flags-head: 065 {
diag-flags-head: 066   VISIBILITY_DEFAULT,
diag-flags-head: 067   VISIBILITY_INTERNAL,
diag-flags-head: 068   VISIBILITY_HIDDEN,
diag-flags-head: 069   VISIBILITY_PROTECTED
diag-flags-head: 070 };
diag-flags-head: 071 #endif
diag-flags-head: 072
diag-flags-head: 073 /* The default visibility for all symbols (unless overridden).  */
diag-flags-head: 074 extern enum symbol_visibility default_visibility;
diag-flags-head: 075
diag-flags-head: 076 struct visibility_flags
diag-flags-head: 077 {
diag-flags-head: 078   unsigned inpragma : 1;	/* True when in #pragma GCC visibility.  */
diag-flags-head: 079   unsigned inlines_hidden : 1;	/* True when -finlineshidden in effect.  */
diag-flags-head: 080 };
diag-flags-head: 081
diag-flags-head: 082 /* Global visibility options.  */
diag-flags-head: 083 extern struct visibility_flags visibility_options;
diag-flags-head: 084
diag-flags-head: 085 /* Nonzero means do optimizations.  -opt.  */
diag-flags-head: 086
diag-flags-head: 087 extern int optimize;
diag-flags-head: 088
diag-flags-head: 089 /* Nonzero means optimize for size.  -Os.  */
diag-flags-head: 090
diag-flags-head: 091 extern int optimize_size;
diag-flags-head: 092
diag-flags-head: 093 /* Do print extra warnings (such as for uninitialized variables).
diag-flags-head: 094    -W/-Wextra.  */
diag-flags-head: 095
diag-flags-head: 096 extern bool extra_warnings;
diag-flags-head: 097
diag-flags-head: 098 /* Nonzero to warn about unused variables, functions et.al.  Use
diag-flags-head: 099    set_Wunused() to update the -Wunused-* flags that correspond to the
diag-flags-head: 100    -Wunused option.  */
diag-flags-head: 101
diag-flags-head: 102 extern void set_Wunused (int setting);
diag-flags-head: 103
diag-flags-head: 104 /* Nonzero means warn about function definitions that default the return type
diag-flags-head: 105    or that use a null return and have a return-type other than void.  */
diag-flags-head: 106
diag-flags-head: 107 extern int warn_return_type;
diag-flags-head: 108
diag-flags-head: 109 /* Nonzero means warn about any objects definitions whose size is larger
diag-flags-head: 110    than N bytes.  Also want about function definitions whose returned
diag-flags-head: 111    values are larger than N bytes. The value N is in `larger_than_size'.  */
diag-flags-head: 112
diag-flags-head: 113 extern bool warn_larger_than;
diag-flags-head: 114 extern HOST_WIDE_INT larger_than_size;
diag-flags-head: 115
diag-flags-head: 116 /* Nonzero means warn about constructs which might not be strict
diag-flags-head: 117    aliasing safe.  */
diag-flags-head: 118
diag-flags-head: 119 extern int warn_strict_aliasing;

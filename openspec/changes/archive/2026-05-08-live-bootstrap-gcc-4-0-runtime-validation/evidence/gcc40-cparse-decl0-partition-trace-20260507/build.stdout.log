diag-ggc-head: 023 #define GCC_GGC_H
diag-ggc-head: 024 #include "statistics.h"
diag-ggc-head: 025
diag-ggc-head: 026 /* Symbols are marked with `ggc' for `gcc gc' so as not to interfere with
diag-ggc-head: 027    an external gc library that might be linked in.  */
diag-ggc-head: 028
diag-ggc-head: 029 /* Constants for general use.  */
diag-ggc-head: 030 extern const char empty_string[];	/* empty string */
diag-ggc-head: 031 extern const char digit_vector[];	/* "0" .. "9" */
diag-ggc-head: 032 #define digit_string(d) (digit_vector + ((d) * 2))
diag-ggc-head: 033
diag-ggc-head: 034 /* Internal functions and data structures used by the GTY
diag-ggc-head: 035    machinery.  */
diag-ggc-head: 036
diag-ggc-head: 037 /* The first parameter is a pointer to a pointer, the second a cookie.  */
diag-ggc-head: 038 typedef void (*gt_pointer_operator) (void *, void *);
diag-ggc-head: 039
diag-ggc-head: 040 #include "gtype-desc.h"
diag-ggc-head: 041
diag-ggc-head: 042 /* One of these applies its third parameter (with cookie in the fourth
diag-ggc-head: 043    parameter) to each pointer in the object pointed to by the first
diag-ggc-head: 044    parameter, using the second parameter.  */
diag-ggc-head: 045 typedef void (*gt_note_pointers) (void *, void *, gt_pointer_operator,
diag-ggc-head: 046 				  void *);
diag-ggc-head: 047
diag-ggc-head: 048 /* One of these is called before objects are re-ordered in memory.
diag-ggc-head: 049    The first parameter is the original object, the second is the
diag-ggc-head: 050    subobject that has had its pointers reordered, the third parameter
diag-ggc-head: 051    can compute the new values of a pointer when given the cookie in
diag-ggc-head: 052    the fourth parameter.  */
diag-ggc-head: 053 typedef void (*gt_handle_reorder) (void *, void *, gt_pointer_operator,
diag-ggc-head: 054 				   void *);
diag-ggc-head: 055
diag-ggc-head: 056 /* Used by the gt_pch_n_* routines.  Register an object in the hash table.  */
diag-ggc-head: 057 extern int gt_pch_note_object (void *, void *, gt_note_pointers);
diag-ggc-head: 058
diag-ggc-head: 059 /* Used by the gt_pch_n_* routines.  Register that an object has a reorder
diag-ggc-head: 060    function.  */
diag-ggc-head: 061 extern void gt_pch_note_reorder (void *, void *, gt_handle_reorder);
diag-ggc-head: 062
diag-ggc-head: 063 /* Mark the object in the first parameter and anything it points to.  */
diag-ggc-head: 064 typedef void (*gt_pointer_walker) (void *);
diag-ggc-head: 065
diag-ggc-head: 066 /* Structures for the easy way to mark roots.
diag-ggc-head: 067    In an array, terminated by having base == NULL.  */
diag-ggc-head: 068 struct ggc_root_tab {
diag-ggc-head: 069   void *base;
diag-ggc-head: 070   size_t nelt;
diag-ggc-head: 071   size_t stride;
diag-ggc-head: 072   gt_pointer_walker cb;
diag-ggc-head: 073   gt_pointer_walker pchw;
diag-ggc-head: 074 };
diag-ggc-head: 075 #define LAST_GGC_ROOT_TAB { NULL, 0, 0, NULL, NULL }
diag-ggc-head: 076 /* Pointers to arrays of ggc_root_tab, terminated by NULL.  */
diag-ggc-head: 077 extern const struct ggc_root_tab * const gt_ggc_rtab[];
diag-ggc-head: 078 extern const struct ggc_root_tab * const gt_ggc_deletable_rtab[];
diag-ggc-head: 079 extern const struct ggc_root_tab * const gt_pch_cache_rtab[];
diag-ggc-head: 080 extern const struct ggc_root_tab * const gt_pch_scalar_rtab[];
diag-ggc-head: 081
diag-ggc-head: 082 /* Structure for hash table cache marking.  */
diag-ggc-head: 083 struct htab;
diag-ggc-head: 084 struct ggc_cache_tab {
diag-ggc-head: 085   struct htab * *base;
diag-ggc-head: 086   size_t nelt;
diag-ggc-head: 087   size_t stride;
diag-ggc-head: 088   gt_pointer_walker cb;
diag-ggc-head: 089   gt_pointer_walker pchw;
diag-ggc-head: 090   int (*marked_p) (const void *);
diag-ggc-head: 091 };
diag-ggc-head: 092 #define LAST_GGC_CACHE_TAB { NULL, 0, 0, NULL, NULL, NULL }
diag-ggc-head: 093 /* Pointers to arrays of ggc_cache_tab, terminated by NULL.  */
diag-ggc-head: 094 extern const struct ggc_cache_tab * const gt_ggc_cache_rtab[];
diag-ggc-head: 095
diag-ggc-head: 096 /* If EXPR is not NULL and previously unmarked, mark it and evaluate
diag-ggc-head: 097    to true.  Otherwise evaluate to false.  */
diag-ggc-head: 098 #define ggc_test_and_set_mark(EXPR) \
diag-ggc-head: 099   ((EXPR) != NULL && ((void *) (EXPR)) != (void *) 1 && ! ggc_set_mark (EXPR))
diag-ggc-head: 100

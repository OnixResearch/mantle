diag-builtins-head: 001 /* This file contains the definitions and documentation for the
diag-builtins-head: 002    builtins used in the GNU compiler.
diag-builtins-head: 003    Copyright (C) 2000, 2001, 2002, 2003, 2004, 2005
diag-builtins-head: 004    Free Software Foundation, Inc.
diag-builtins-head: 005
diag-builtins-head: 006 This file is part of GCC.
diag-builtins-head: 007
diag-builtins-head: 008 GCC is free software; you can redistribute it and/or modify it under
diag-builtins-head: 009 the terms of the GNU General Public License as published by the Free
diag-builtins-head: 010 Software Foundation; either version 2, or (at your option) any later
diag-builtins-head: 011 version.
diag-builtins-head: 012
diag-builtins-head: 013 GCC is distributed in the hope that it will be useful, but WITHOUT ANY
diag-builtins-head: 014 WARRANTY; without even the implied warranty of MERCHANTABILITY or
diag-builtins-head: 015 FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
diag-builtins-head: 016 for more details.
diag-builtins-head: 017
diag-builtins-head: 018 You should have received a copy of the GNU General Public License
diag-builtins-head: 019 along with GCC; see the file COPYING.  If not, write to the Free
diag-builtins-head: 020 Software Foundation, 59 Temple Place - Suite 330, Boston, MA
diag-builtins-head: 021 02111-1307, USA.  */
diag-builtins-head: 022
diag-builtins-head: 023 /* Before including this file, you should define a macro:
diag-builtins-head: 024
diag-builtins-head: 025      DEF_BUILTIN (ENUM, NAME, CLASS, TYPE, LIBTYPE, BOTH_P,
diag-builtins-head: 026                   FALLBACK_P, NONANSI_P, ATTRS, IMPLICIT)
diag-builtins-head: 027
diag-builtins-head: 028    This macro will be called once for each builtin function.  The
diag-builtins-head: 029    ENUM will be of type `enum built_in_function', and will indicate
diag-builtins-head: 030    which builtin function is being processed.  The NAME of the builtin
diag-builtins-head: 031    function (which will always start with `__builtin_') is a string
diag-builtins-head: 032    literal.  The CLASS is of type `enum built_in_class' and indicates
diag-builtins-head: 033    what kind of builtin is being processed.
diag-builtins-head: 034
diag-builtins-head: 035    Some builtins are actually two separate functions.  For example,
diag-builtins-head: 036    for `strcmp' there are two builtin functions; `__builtin_strcmp'
diag-builtins-head: 037    and `strcmp' itself.  Both behave identically.  Other builtins
diag-builtins-head: 038    define only the `__builtin' variant.  If BOTH_P is TRUE, then this
diag-builtins-head: 039    builtin has both variants; otherwise, it is has only the first
diag-builtins-head: 040    variant.
diag-builtins-head: 041
diag-builtins-head: 042    TYPE indicates the type of the function.  The symbols correspond to
diag-builtins-head: 043    enumerals from builtin-types.def.  If BOTH_P is true, then LIBTYPE
diag-builtins-head: 044    is the type of the non-`__builtin_' variant.  Otherwise, LIBTYPE
diag-builtins-head: 045    should be ignored.
diag-builtins-head: 046
diag-builtins-head: 047    If FALLBACK_P is true then, if for some reason, the compiler cannot
diag-builtins-head: 048    expand the builtin function directly, it will call the
diag-builtins-head: 049    corresponding library function (which does not have the
diag-builtins-head: 050    `__builtin_' prefix.
diag-builtins-head: 051
diag-builtins-head: 052    If NONANSI_P is true, then the non-`__builtin_' variant is not an
diag-builtins-head: 053    ANSI/ISO library function, and so we should pretend it does not
diag-builtins-head: 054    exist when compiling in ANSI conformant mode.
diag-builtins-head: 055
diag-builtins-head: 056    ATTRs is an attribute list as defined in builtin-attrs.def that
diag-builtins-head: 057    describes the attributes of this builtin function.
diag-builtins-head: 058
diag-builtins-head: 059    IMPLICIT specifies condition when the builtin can be produced by
diag-builtins-head: 060    compiler.  For instance C90 reserves floorf function, but does not
diag-builtins-head: 061    define it's meaning.  When user uses floorf we may assume that the
diag-builtins-head: 062    floorf has the meaning we expect, but we can't produce floorf by
diag-builtins-head: 063    simplifying floor((double)float) since the runtime need not implement
diag-builtins-head: 064    it.  */
diag-builtins-head: 065
diag-builtins-head: 066 /* A GCC builtin (like __builtin_saveregs) is provided by the
diag-builtins-head: 067    compiler, but does not correspond to a function in the standard
diag-builtins-head: 068    library.  */
diag-builtins-head: 069 #undef DEF_GCC_BUILTIN
diag-builtins-head: 070 #define DEF_GCC_BUILTIN(ENUM, NAME, TYPE, ATTRS)		\
diag-builtins-head: 071   DEF_BUILTIN (ENUM, "__builtin_" NAME, BUILT_IN_NORMAL, TYPE, BT_LAST,	\
diag-builtins-head: 072                false, false, false, ATTRS, true, true)
diag-builtins-head: 073
diag-builtins-head: 074 /* A library builtin (like __builtin_strchr) is a builtin equivalent
diag-builtins-head: 075    of an ANSI/ISO standard library function.  In addition to the
diag-builtins-head: 076    `__builtin' version, we will create an ordinary version (e.g,
diag-builtins-head: 077    `strchr') as well.  If we cannot compute the answer using the
diag-builtins-head: 078    builtin function, we will fall back to the standard library
diag-builtins-head: 079    version.  */
diag-builtins-head: 080 #undef DEF_LIB_BUILTIN
diag-builtins-head: 081 #define DEF_LIB_BUILTIN(ENUM, NAME, TYPE, ATTRS)	\
diag-builtins-head: 082   DEF_BUILTIN (ENUM, "__builtin_" NAME, BUILT_IN_NORMAL, TYPE, TYPE,	\
diag-builtins-head: 083 	       true, true, false, ATTRS, true, true)
diag-builtins-head: 084
diag-builtins-head: 085 /* Like DEF_LIB_BUILTIN, except that the function is not one that is
diag-builtins-head: 086    specified by ANSI/ISO C.  So, when we're being fully conformant we
diag-builtins-head: 087    ignore the version of these builtins that does not begin with
diag-builtins-head: 088    __builtin.  */
diag-builtins-head: 089 #undef DEF_EXT_LIB_BUILTIN
diag-builtins-head: 090 #define DEF_EXT_LIB_BUILTIN(ENUM, NAME, TYPE, ATTRS)	\
diag-builtins-head: 091   DEF_BUILTIN (ENUM, "__builtin_" NAME, BUILT_IN_NORMAL, TYPE, TYPE,	\
diag-builtins-head: 092    	       true, true, true, ATTRS, false, true)
diag-builtins-head: 093
diag-builtins-head: 094 /* Like DEF_LIB_BUILTIN, except that the function is only a part of
diag-builtins-head: 095    the standard in C94 or above.  */
diag-builtins-head: 096 #undef DEF_C94_BUILTIN
diag-builtins-head: 097 #define DEF_C94_BUILTIN(ENUM, NAME, TYPE, ATTRS)	\
diag-builtins-head: 098   DEF_BUILTIN (ENUM, "__builtin_" NAME, BUILT_IN_NORMAL, TYPE, TYPE,	\
diag-builtins-head: 099    	       true, true, !flag_isoc94, ATTRS, TARGET_C99_FUNCTIONS, true)
diag-builtins-head: 100
diag-builtins-head: 101 /* Like DEF_LIB_BUILTIN, except that the function is only a part of
diag-builtins-head: 102    the standard in C99 or above.  */
diag-builtins-head: 103 #undef DEF_C99_BUILTIN
diag-builtins-head: 104 #define DEF_C99_BUILTIN(ENUM, NAME, TYPE, ATTRS)	\
diag-builtins-head: 105   DEF_BUILTIN (ENUM, "__builtin_" NAME, BUILT_IN_NORMAL, TYPE, TYPE,	\
diag-builtins-head: 106    	       true, true, !flag_isoc99, ATTRS, TARGET_C99_FUNCTIONS, true)
diag-builtins-head: 107
diag-builtins-head: 108 /* Builtin that is specified by C99 and C90 reserve the name for future use.
diag-builtins-head: 109    We can still recognize the builtin in C90 mode but we can't produce it
diag-builtins-head: 110    implicitly.  */
diag-builtins-head: 111 #undef DEF_C99_C90RES_BUILTIN
diag-builtins-head: 112 #define DEF_C99_C90RES_BUILTIN(ENUM, NAME, TYPE, ATTRS)	\
diag-builtins-head: 113   DEF_BUILTIN (ENUM, "__builtin_" NAME, BUILT_IN_NORMAL, TYPE, TYPE,	\
diag-builtins-head: 114    	       true, true, !flag_isoc99, ATTRS, TARGET_C99_FUNCTIONS, true)
diag-builtins-head: 115
diag-builtins-head: 116 /* Allocate the enum and the name for a builtin, but do not actually
diag-builtins-head: 117    define it here at all.  */
diag-builtins-head: 118 #undef DEF_BUILTIN_STUB
diag-builtins-head: 119 #define DEF_BUILTIN_STUB(ENUM, NAME) \
diag-builtins-head: 120   DEF_BUILTIN (ENUM, NAME, BUILT_IN_NORMAL, 0, 0, false, false, \

diag-c-common-head: 042 /* Reserved identifiers.  This is the union of all the keywords for C,
diag-c-common-head: 043    C++, and Objective-C.  All the type modifiers have to be in one
diag-c-common-head: 044    block at the beginning, because they are used as mask bits.  There
diag-c-common-head: 045    are 27 type modifiers; if we add many more we will have to redesign
diag-c-common-head: 046    the mask mechanism.  */
diag-c-common-head: 047
diag-c-common-head: 048 enum rid
diag-c-common-head: 049 {
diag-c-common-head: 050   /* Modifiers: */
diag-c-common-head: 051   /* C, in empirical order of frequency.  */
diag-c-common-head: 052   RID_STATIC = 0,
diag-c-common-head: 053   RID_UNSIGNED, RID_LONG,    RID_CONST, RID_EXTERN,
diag-c-common-head: 054   RID_REGISTER, RID_TYPEDEF, RID_SHORT, RID_INLINE,
diag-c-common-head: 055   RID_VOLATILE, RID_SIGNED,  RID_AUTO,  RID_RESTRICT,
diag-c-common-head: 056
diag-c-common-head: 057   /* C extensions */
diag-c-common-head: 058   RID_COMPLEX, RID_THREAD,
diag-c-common-head: 059
diag-c-common-head: 060   /* C++ */
diag-c-common-head: 061   RID_FRIEND, RID_VIRTUAL, RID_EXPLICIT, RID_EXPORT, RID_MUTABLE,
diag-c-common-head: 062
diag-c-common-head: 063   /* ObjC */
diag-c-common-head: 064   RID_IN, RID_OUT, RID_INOUT, RID_BYCOPY, RID_BYREF, RID_ONEWAY,
diag-c-common-head: 065
diag-c-common-head: 066   /* C */
diag-c-common-head: 067   RID_INT,     RID_CHAR,   RID_FLOAT,    RID_DOUBLE, RID_VOID,
diag-c-common-head: 068   RID_ENUM,    RID_STRUCT, RID_UNION,    RID_IF,     RID_ELSE,
diag-c-common-head: 069   RID_WHILE,   RID_DO,     RID_FOR,      RID_SWITCH, RID_CASE,
diag-c-common-head: 070   RID_DEFAULT, RID_BREAK,  RID_CONTINUE, RID_RETURN, RID_GOTO,
diag-c-common-head: 071   RID_SIZEOF,
diag-c-common-head: 072
diag-c-common-head: 073   /* C extensions */
diag-c-common-head: 074   RID_ASM,       RID_TYPEOF,   RID_ALIGNOF,  RID_ATTRIBUTE,  RID_VA_ARG,
diag-c-common-head: 075   RID_EXTENSION, RID_IMAGPART, RID_REALPART, RID_LABEL,      RID_CHOOSE_EXPR,
diag-c-common-head: 076   RID_TYPES_COMPATIBLE_P,
diag-c-common-head: 077
diag-c-common-head: 078   /* Too many ways of getting the name of a function as a string */
diag-c-common-head: 079   RID_FUNCTION_NAME, RID_PRETTY_FUNCTION_NAME, RID_C99_FUNCTION_NAME,
diag-c-common-head: 080

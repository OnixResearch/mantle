ublic License\ndiag-tree-head: 018 along with GCC; see the file COPYING.  If not, write to the Free\ndiag-tree-head: 019 Software Foundation, 59 Temple Place - Suite 330, Boston, MA\ndiag-tree-head: 020 02111-1307, USA.  */\ndiag-tree-head: 021 \ndiag-tree-head: 022 #ifndef GCC_TREE_H\ndiag-tree-head: 023 #define GCC_TREE_H\ndiag-tree-head: 024 \ndiag-tree-head: 025 #include \"machmode.h\"\ndiag-tree-head: 026 #include \"input.h\"\ndiag-tree-head: 027 #include \"statistics.h\"\ndiag-tree-head: 028 #include \"vec.h\"\ndiag-tree-head: 029 \ndiag-tree-head: 030 /* Codes of tree nodes */\ndiag-tree-head: 031 \ndiag-tree-head: 032 #define DEFTREECODE(SYM, STRING, TYPE, NARGS)   SYM,\ndiag-tree-head: 033 \ndiag-tree-head: 034 enum tree_code {\ndiag-tree-head: 035 #include \"tree.def\"\ndiag-tree-head: 036 \ndiag-tree-head: 037   LAST_AND_UNUSED_TREE_CODE\t/* A convenient way to get a value for\ndiag-tree-head: 038 \t\t\t\t   NUM_TREE_CODES.  */\ndiag-tree-head: 039 };\ndiag-tree-head: 040 \ndiag-tree-head: 041 #undef DEFTREECODE\ndiag-tree-head: 042 \ndiag-tree-head: 043 /* Number of language-independent tree codes.  */\ndiag-tree-head: 044 #define NUM_TREE_CODES ((int) LAST_AND_UNUSED_TREE_CODE)\ndiag-tree-head: 045 \ndiag-tree-head: 046 /* Tree code classes.  */\ndiag-tree-head: 047 \ndiag-tree-head: 048 /* Each tree_code has an associated code class represented by a\ndiag-tree-head: 049    TREE_CODE_CLASS.  */\ndiag-tree-head: 050 \ndiag-tree-head: 051 enum tree_code_class {\ndiag-tree-head: 052   tcc_exceptional, /* An exceptional code (fits no category).  */\ndiag-tree-head: 053   tcc_constant,    /* A constant.  */\ndiag-tree-head: 054   /* Order of tcc_type and tcc_declaration is important.  */\ndiag-tree-head: 055   tcc_type,        /* A type object code.  */\ndiag-tree-head: 056   tcc_declaration, /* A declaration (also serving as variable refs).  */\ndiag-tree-head: 057   tcc_reference,   /* A reference to storage.  */\ndiag-tree-head: 058   tcc_comparison,  /* A comparison expression.  */\ndiag-tree-head: 059   tcc_unary,       /* A unary arithmetic expression.  */\ndiag-tree-head: 060   tcc_binary,      /* A binary arithmetic expression.  */\ndiag-tree-head: 061   tcc_statement,   /* A statement expression, which have side effects\ndiag-tree-head: 062 \t\t      but usually no interesting value.  */\ndiag-tree-head: 063   tcc_expression   /* Any other expression.  */\ndiag-tree-head: 064 };\ndiag-tree-head: 065 \ndiag-tree-head: 066 /* Each tree code class has an associated string representation.\ndiag-tree-head: 067    These must correspond to the tree_code_class entries.  */\ndiag-tree-head: 068 \ndiag-tree-head: 069 extern const char *const tree_code_class_strings[];\ndiag-tree-head: 070 \ndiag-tree-head: 071 /* Returns the string representing CLASS.  */\ndiag-tree-head: 072 \ndiag-tree-head: 073 #define TREE_CODE_CLASS_STRING(CLASS)\\\ndiag-tree-head: 074         tree_code_class_strings[(int) (CLASS)]\ndiag-tree-head: 075 \ndiag-tree-head: 076 #define MAX_TREE_CODES 256\ndiag-tree-head: 077 extern const enum tree_code_class tree_code_type[];\ndiag-tree-head: 078 #define TREE_CODE_CLASS(CODE)\ttree_code_type[(int) (CODE)]\ndiag-tree-head: 079 \ndiag-tree-head: 080 /* Nonzero if CODE represents an exceptional code.  */\ndiag-tree-head: 081 \ndiag-tree-head: 082 #define EXCEPTIONAL_CLASS_P(CODE)\\\ndiag-tree-head: 083 \t(TREE_CODE_CLASS (TREE_CODE (CODE)) == tcc_exceptional)\ndiag-tree-head: 084 \ndiag-tree-head: 085 /* Nonzero if CODE represents a constant.  */\ndiag-tree-head: 086 \ndiag-tree-head: 087 #define CONSTANT_CLASS_P(CODE)\\\ndiag-tree-head: 088 \t(TREE_CODE_CLASS (TREE_CODE (CODE)) == tcc_constant)\ndiag-tree-head: 089 \ndiag-tree-head: 090 /* Nonzero if CODE represents a type.  */\ndiag-tree-head: 091 \ndiag-tree-head: 092 #define TYPE_P(CODE)\\\ndiag-tree-head: 093 \t(TREE_CODE_CLASS (TREE_CODE (CODE)) == tcc_type)\ndiag-tree-head: 094 \ndiag-tree-head: 095 /* Nonzero if CODE represents a declaration.  */\ndiag-tree-head: 096 \ndiag-tree-head: 097 #define DECL_P(CODE)\\\ndiag-tree-head: 098         (TREE_CODE_CLASS (TREE_CODE (CODE)) == tcc_declaration)\ndiag-tree-head: 099 \ndiag-tree-head: 100 /* Nonzero if CODE represents a INDIRECT_REF.  Keep these checks in\ndiag-tree-head: 101    ascending code order.  */\ndiag-tree-head: 102 #define INDIRECT_REF_P(CODE)\\\ndiag-tree-head: 103   (TREE_CODE (CODE) == INDIRECT_REF \\\ndiag-tree-head: 104    || TREE_CODE (CODE) == ALIGN_INDIRECT_REF \\\ndiag-tree-head: 105    || TREE_CODE (CODE) == MISALIGNED_INDIRECT_REF)\ndiag-tree-head: 106 \ndiag-tree-head: 107 /* Nonzero if CODE represents a reference.  */\ndiag-tree-head: 108 \ndiag-tree-head: 109 #define REFERENCE_CLASS_P(CODE)\\\ndiag-tree-head: 110 \t(TREE_CODE_CLASS (TREE_CODE (CODE)) == tcc_reference)\ndiag-tree-head: 111 \ndiag-tree-head: 112 /* Nonzero if CODE represents a comparison.  */\ndiag-tree-head: 113 \ndiag-tree-head: 114 #define COMPARISON_CLASS_P(CODE)\\\ndiag-tree-head: 115 \t(TREE_CODE_CLASS (TREE_CODE (CODE)) == tcc_comparison)\ndiag-tree-head: 116 \ndiag-tree-head: 117 /* Nonzero if CODE represents a unary arithmetic expression.  */\ndiag-tree-head: 118 \ndiag-tree-head: 119 #define UNARY_CLASS_P(CODE)\\\ndiag-tree-head: 120 \t(TREE_CODE_CLASS (TREE_CODE (CODE)) == tcc_unary)\ndiag-tree-head: 121 \ndiag-tree-head: 122 /* Nonzero if CODE represents a binary arithmetic expression.  */\ndiag-tree-head: 123 \ndiag-tree-head: 124 #define BINARY_CLASS_P(CODE)\\\ndiag-tree-head: 125 \t(TREE_CODE_CLASS (TREE_CODE (CODE)) == tcc_binary)\ndiag-tree-head: 126 \ndiag-tree-head: 127 /* Nonzero if CODE represents a statement expression.  */\ndiag-tree-head: 128 \ndiag-tree-head: 129 #define STATEMENT_CLASS_P(CODE)\\\ndiag-tree-head: 130 \t(TREE_CODE_CLASS (TREE_CODE (CODE)) == tcc_statement)\ndiag-tree-head: 131 \ndiag-tree-head: 132 /* Nonzero if CODE represents any other expression.  */\ndiag-tree-head: 133 \ndiag-tree-head: 134 #define EXPRESSION_CLASS_P(CODE)\\\ndiag-tree-head: 135 \t(TREE_CODE_CLASS (TREE_CODE (CODE)) == tcc_expression)\ndiag-tree-head: 136 \ndiag-tree-head: 137 /* Returns nonzero iff CLASS is not the tree code of a type.  */\ndiag-tree-head: 138 \ndiag-tree-head: 139 #define IS_NON_TYPE_CODE_CLASS(CLASS) ((CLASS) != tcc_type)\ndiag-tree-head: 140 \ndiag-tree-head: 141 /* Returns nonzero iff CODE represents a type or declaration.  */\ndiag-tree-head: 142 \ndiag-tree-head: 143 #define IS_TYPE_OR_DECL_P(CODE)\\\ndiag-tree-head: 144 \t(TYPE_P (CODE) || DECL_P (CODE))\ndiag-tree-head: 145 \ndiag-tree-head: 146 /* Returns nonzero iff CLASS is the tree-code class of an\ndiag-tree-head: 147    expression.  */\ndiag-tree-head: 148 \ndiag-tree-head: 149 #define IS_EXPR_CODE_CLASS(CLASS)\\\ndiag-tree-head: 150 \t((CLASS) >= tcc_reference && (CLASS) <= tcc_expression)\ndiag-tree-head: 151 \ndiag-tree-head: 152 /* Returns nonzero iff NODE is an expression of some kind.  */\ndiag-tree-head: 153 \ndiag-tree-head: 154 #define EXPR_P(NODE) IS_EXPR_CODE_CLASS (TREE_CODE_CLASS (TREE_CODE (NODE)))\ndiag-tree-head: 155 \ndiag-tree-head: 156 /* Number of argument-words in each kind of tree-node.  */\ndiag-tree-head: 157 \ndiag-tree-head: 158 extern const unsigned char tree_code_length[];\ndiag-tree-head: 159 #define TREE_CODE_LENGTH(CODE)\ttree_code_length[(int) (CODE)]\ndiag-tree-head: 160 \ndiag-tree-head: 161 /* Names of tree components.  */\ndiag-tree-head: 162 \ndiag-tree-head: 163 extern const char *const tree_code_name[];\ndiag-tree-head: 164 \ndiag-tree-head: 165 /* A garbage collected vector of trees.  */\ndiag-tree-head: 166 DEF_VEC_GC_P(tree);\ndiag-tree-head: 167 \ndiag-tree-head: 168 \f\ndiag-tree-head: 169 /* Classify which part of the compiler has defined a given builtin function.\ndiag-tree-head: 170    Note that we assume below that this is no more than two bits.  */\ndiag-tree-head: 171 enum built_in_class\ndiag-tree-head: 172 {\ndiag-tree-head: 173   NOT_BUILT_IN = 0,\ndiag-tree-head: 174   BUILT_IN_FRONTEND,\ndiag-tree-head: 175   BUILT_IN_MD,\ndiag-tree-head: 176   BUILT_IN_NORMAL\ndiag-tree-head: 177 };\ndiag-tree-head: 178 \ndiag-tree-head: 179 /* Names for the above.  */\ndiag-tree-head: 180 extern const char *const built_in_class_names[4];\ndiag-tree-head: 181 \ndiag-tree-head: 182 /* Codes that identify the various built in functions\ndiag-tree-head: 183    so that expand_call can identify them quickly.  */\ndiag-tree-head: 184 \ndiag-tree-head: 185 #define DEF_BUILTIN(ENUM, N, C, T, LT, B, F, NA, AT, IM, COND) ENUM,\ndiag-tree-head: 186 enum built_in_function\ndiag-tree-head: 187 {\ndiag-tree-head: 188 #include \"builtins.def\"\ndiag-tree-head: 189 \ndiag-tree-head: 190   /* Complex division routines in libgcc.  These are done via builtins\ndiag-tree-head: 191      because emit_library_call_value can't handle complex values.  */\ndiag-tree-head: 192   BUILT_IN_COMPLEX_MUL_MIN,\ndiag-tree-head: 193   BUILT_IN_COMPLEX_MUL_MAX\ndiag-tree-head: 194     = BUILT_IN_COMPLEX_MUL_MIN\ndiag-tree-head: 195       + MAX_MODE_COMPLEX_FLOAT\ndiag-tree-head: 196       - MIN_MODE_COMPLEX_FLOAT,\ndiag-tree-head: 197 \ndiag-tree-head: 198   BUILT_IN_COMPLEX_DIV_MIN,\ndiag-tree-head: 199   BUILT_IN_COMPLEX_DIV_MAX\ndiag-tree-head: 200     = BUILT_IN_COMPLEX_DIV_MIN\ndiag-tree-head: 201       + MAX_MODE_COMPLEX_FLOAT\ndiag-tree-head: 202       - MIN_MODE_COMPLEX_FLOAT,\ndiag-tree-head: 203 \ndiag-tree-head: 204   /* Upper bound on non-language-specific builtins.  */\ndiag-tree-head: 205   END_BUILTINS\ndiag-tree-head: 206 };\ndiag-tree-head: 207 #undef DEF_BUILTIN\ndiag-tree-head: 208 \ndiag-tree-head: 209 /* Names for the above.  */\ndiag-tree-head: 210 extern const char * built_in_names[(int) END_BUILTINS];\ndiag-tree-head: 211 \ndiag-tree-head: 212 /* Helper macros for math builtins.  */\ndiag-tree-head: 213 \ndiag-tree-head: 214 #define BUILTIN_EXP10_P(FN) \\\ndiag-tree-head: 215  ((FN) == BUILT_IN_EXP10 || (FN) == BUILT_IN_EXP10F || (FN) == BUILT_IN_EXP10L \\\ndiag-tree-head: 216   || (FN) == BUILT_IN_POW10 || (FN) == BUILT_IN_POW10F || (FN) == BUILT_IN_POW10L)\ndiag-tree-head: 217 \ndiag-tree-head: 218 #define BUILTIN_EXPONENT_P(FN) (BUILTIN_EXP10_P (FN) \\\ndiag-tree-head: 219   || (FN) == BUILT_IN_EXP || (FN) == BUILT_IN_EXPF || (FN) == BUILT_IN_EXPL \\\ndiag-tree-head: 220   || (FN) == BUILT_IN_EXP2 || (FN) == BUILT_IN_EXP2F || (FN) == BUILT_IN_EXP2L)\ndiag-cparse: compile cparse_undef6_tree_guard_only\ndiag-cparse: cparse_undef6_tree_guard_only rc=0\ndiag-cparse: compile cparse_undef6_tree_machmode_only\ndiag-cparse: cparse_undef6_tree_machmode_only rc=0\ndiag-cparse: compile cparse_undef6_tree_input_only\ndiag-cparse: cparse_undef6_tree_input_only rc=0\ndiag-cparse: compile cparse_undef6_tree_statistics_only\ndiag-cparse: cparse_undef6_tree_statistics_only rc=0\ndiag-cparse: compile cparse_undef6_tree_vec_only\ndiag-cparse: cparse_undef6_tree_vec_only rc=0\ndiag-cparse: compile cparse_undef6_tree_def_enum\ndiag-cparse: cparse_undef6_tree_def_enum rc=0\ndiag-cparse: compile cparse_undef6_tree_lines_23\ndiag-cparse: cparse_undef6_tree_lines_23 rc=0\ndiag-cparse: compile cparse_undef6_tree_lines_25\ndiag-cparse: cparse_undef6_tree_lines_25 rc=0\ndiag-cparse: compile cparse_undef6_tree_lines_26\ndiag-cparse: cparse_undef6_tree_lines_26 rc=0\ndiag-cparse: compile cparse_undef6_tree_lines_27\ndiag-cparse: cparse_undef6_tree_lines_27 rc=0\ndiag-cparse: compile cparse_undef6_tree_lines_28\ndiag-cparse: cparse_undef6_tree_lines_28 rc=0\ndiag-cparse: compile cparse_undef6_tree_lines_36\nSegmentation fault (core dumped)\ndiag-cparse: cparse_undef6_tree_lines_36 rc=139\ndiag-cparse: compile cparse_undef6_tree_lines_80\ndiag-cparse: cparse_undef6_tree_lines_80 rc=0\ndiag-cparse: compile cparse_undef6_tree_lines_120\ndiag-cparse: cparse_undef6_tree_lines_120 rc=0\ndiag-cparse: compile cparse_undef6_tree_lines_160\ndiag-cparse: cparse_undef6_tree_lines_160 rc=0\ndiag-cparse: compile cparse_undef6_tree_lines_166\ndiag-cparse: cparse_undef6_tree_lines_166 rc=0\ndiag-cparse: compile cparse_undef6_tree_lines_177\ndiag-cparse: cparse_undef6_tree_lines_177 rc=0\ndiag-cparse: compile cparse_undef6_tree_lines_180\ndiag-cparse: cparse_undef6_tree_lines_180 rc=0\ndiag-cparse: compile cparse_undef6_tree_lines_207\ndiag-cparse: cparse_undef6_tree_lines_207 rc=0\ndiag-cparse: compile cparse_undef6_tree_lines_212\ndiag-cparse: cparse_undef6_tree_lines_212 rc=0\ndiag-cparse: compile cparse_undef6_tree_lines_220\ndiag-cparse: cparse_undef6_tree_lines_220 rc=0\ndiag-builtins-head: 001 /* This file contains the definitions and documentation for the\ndiag-builtins-head: 002    builtins used in the GNU compiler.\ndiag-builtins-head: 003    Copyright (C) 2000, 2001, 2002, 2003, 2004, 2005\ndiag-builtins-head: 004    Free Software Foundation, Inc.\ndiag-builtins-head: 005 \ndiag-builtins-head: 006 This file is part of GCC.\ndiag-builtins-head: 007 \ndiag-builtins-head: 008 GCC is free software; you can redistribute it and/or modify it under\ndiag-builtins-head: 009 the terms of the GNU General Public License as published by the Free\ndiag-builtins-head: 010 Software Foundation; either version 2, or (at your option) any later\ndiag-builtins-head: 011 version.\ndiag-builtins-head: 012 \ndiag-builtins-head: 013 GCC is distributed in the hope that it will be useful, but WITHOUT ANY\ndiag-builtins-head: 014 WARRANTY; without even the implied warranty of MERCHANTABILITY or\ndiag-builtins-head: 015 FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License\ndiag-builtins-head: 016 for more details.\ndiag-builtins-head: 017 \ndiag-builtins-head: 018 You should have received a copy of the GNU General Public License\ndiag-builtins-head: 019 along with GCC; see the file COPYING.  If not, write to the Free\ndiag-builtins-head: 020 Software Foundation, 59 Temple Place - Suite 330, Boston, MA\ndiag-builtins-head: 021 02111-1307, USA.  */\ndiag-builtins-head: 022 \ndiag-builtins-head: 023 /* Before including this file, you should define a macro:\ndiag-builtins-head: 024 \ndiag-builtins-head: 025      DEF_BUILTIN (ENUM, NAME, CLASS, TYPE, LIBTYPE, BOTH_P,\ndiag-builtins-head: 026                   FALLBACK_P, NONANSI_P, ATTRS, IMPLICIT)\ndiag-builtins-head: 027 \ndiag-builtins-head: 028    This macro will be called once for each builtin function.  The\ndiag-builtins-head: 029    ENUM will be of type `enum built_in_function', and will indicate\ndiag-builtins-head: 030    which builtin function is being processed.  The NAME of the builtin\ndiag-builtins-head: 031    function (which will always start with `__builtin_') is a string\ndiag-builtins-head: 032    literal.  The CLASS is of type `enum built_in_class' and indicates\ndiag-builtins-head: 033    what kind of builtin is being processed.\ndiag-builtins-head: 034 \ndiag-builtins-head: 035    Some builtins are actually two separate functions.  For example,\ndiag-builtins-head: 036    for `strcmp' there are two builtin functions; `__builtin_strcmp'\ndiag-builtins-head: 037    and `strcmp' itself.  Both behave identically.  Other builtins\ndiag-builtins-head: 038    define only the `__builtin' variant.  If BOTH_P is TRUE, then this\ndiag-builtins-head: 039    builtin has both variants; otherwise, it is has only the first\ndiag-builtins-head: 040    variant.\ndiag-builtins-head: 041 \ndiag-builtins-head: 042    TYPE indicates the type of the function.  The symbols correspond to\ndiag-builtins-head: 043    enumerals from builtin-types.def.  If BOTH_P is true, then LIBTYPE\ndiag-builtins-head: 044    is the type of the non-`__builtin_' variant.  Otherwise, LIBTYPE\ndiag-builtins-head: 045    should be ignored.\ndiag-builtins-head: 046 \ndiag-builtins-head: 047    If FALLBACK_P is true then, if for some reason, the compiler cannot\ndiag-builtins-head: 048    expand the builtin function directly, it will call the\ndiag-builtins-head: 049    corresponding library function (which does not have the\ndiag-builtins-head: 050    `__builtin_' prefix.\ndiag-builtins-head: 051 \ndiag-builtins-head: 052    If NONANSI_P is true, then the non-`__builtin_' variant is not an\ndiag-builtins-head: 053    ANSI/ISO library function, and so we should pretend it does not\ndiag-builtins-head: 054    exist when compiling in ANSI conformant mode.\ndiag-builtins-head: 055 \ndiag-builtins-head: 056    ATTRs is an attribute list as defined in builtin-attrs.def that\ndiag-builtins-head: 057    describes the attributes of this builtin function.  \ndiag-builtins-head: 058 \ndiag-builtins-head: 059    IMPLICIT specifies condition when the builtin can be produced by\ndiag-builtins-head: 060    compiler.  For instance C90 reserves floorf function, but does not\ndiag-builtins-head: 061    define it's meaning.  When user uses floorf we may assume that the\ndiag-builtins-head: 062    floorf has the meaning we expect, but we can't produce floorf by\ndiag-builtins-head: 063    simplifying floor((double)float) since the runtime need not implement\ndiag-builtins-head: 064    it.  */\ndiag-builtins-head: 065    \ndiag-builtins-head: 066 /* A GCC builtin (like __builtin_saveregs) is provided by the\ndiag-builtins-head: 067    compiler, but does not correspond to a function in the standard\ndiag-builtins-head: 068    library.  */\ndiag-builtins-head: 069 #undef DEF_GCC_BUILTIN\ndiag-builtins-head: 070 #define DEF_GCC_BUILTIN(ENUM, NAME, TYPE, ATTRS)\t\t\\\ndiag-builtins-head: 071   DEF_BUILTIN (ENUM, \"__builtin_\" NAME, BUILT_IN_NORMAL, TYPE, BT_LAST,\t\\\ndiag-builtins-head: 072                false, false, false, ATTRS, true, true)\ndiag-builtins-head: 073 \ndiag-builtins-head: 074 /* A library builtin (like __builtin_strchr) is a builtin equivalent\ndiag-builtins-head: 075    of an ANSI/ISO standard library function.  In addition to the\ndiag-builtins-head: 076    `__builtin' version, we will create an ordinary version (e.g,\ndiag-builtins-head: 077    `strchr') as well.  If we cannot compute the answer using the\ndiag-builtins-head: 078    builtin function, we will fall back to the standard library\ndiag-builtins-head: 079    version.  */\ndiag-builtins-head: 080 #undef DEF_LIB_BUILTIN\t\t\t\t\t\ndiag-builtins-head: 081 #define DEF_LIB_BUILTIN(ENUM, NAME, TYPE, ATTRS)\t\\\ndiag-builtins-head: 082   DEF_BUILTIN (ENUM, \"__builtin_\" NAME, BUILT_IN_NORMAL, TYPE, TYPE,\t\\\ndiag-builtins-head: 083 \t       true, true, false, ATTRS, true, true)\ndiag-builtins-head: 084 \ndiag-builtins-head: 085 /* Like DEF_LIB_BUILTIN, except that the function is not one that is\ndiag-builtins-head: 086    specified by ANSI/ISO C.  So, when we're being fully conformant we\ndiag-builtins-head: 087    ignore the version of these builtins that does not begin with\ndiag-builtins-head: 088    __builtin.  */\ndiag-builtins-head: 089 #undef DEF_EXT_LIB_BUILTIN\t\t\t\t\ndiag-builtins-head: 090 #define DEF_EXT_LIB_BUILTIN(ENUM, NAME, TYPE, ATTRS)\t\\\ndiag-builtins-head: 091   DEF_BUILTIN (ENUM, \"__builtin_\" NAME, BUILT_IN_NORMAL, TYPE, TYPE,\t\\\ndiag-builtins-head: 092    \t       true, true, true, ATTRS, false, true)\ndiag-builtins-head: 093 \ndiag-builtins-head: 094 /* Like DEF_LIB_BUILTIN, except that the function is only a part of\ndiag-builtins-head: 095    the standard in C94 or above.  */\ndiag-builtins-head: 096 #undef DEF_C94_BUILTIN\t\t\t\t\t\ndiag-builtins-head: 097 #define DEF_C94_BUILTIN(ENUM, NAME, TYPE, ATTRS)\t\\\ndiag-builtins-head: 098   DEF_BUILTIN (ENUM, \"__builtin_\" NAME, BUILT_IN_NORMAL, TYPE, TYPE,\t\\\ndiag-builtins-head: 099    \t       true, true, !flag_isoc94, ATTRS, TARGET_C99_FUNCTIONS, true)\ndiag-builtins-head: 100 \ndiag-builtins-head: 101 /* Like DEF_LIB_BUILTIN, except that the function is only a part of\ndiag-builtins-head: 102    the standard in C99 or above.  */\ndiag-builtins-head: 103 #undef DEF_C99_BUILTIN\t\t\t\t\t\ndiag-builtins-head: 104 #define DEF_C99_BUILTIN(ENUM, NAME, TYPE, ATTRS)\t\\\ndiag-builtins-head: 105   DEF_BUILTIN (ENUM, \"__builtin_\" NAME, BUILT_IN_NORMAL, TYPE, TYPE,\t\\\ndiag-builtins-head: 106    \t       true, true, !flag_isoc99, ATTRS, TARGET_C99_FUNCTIONS, true)\ndiag-builtins-head: 107 \ndiag-builtins-head: 108 /* Builtin that is specified by C99 and C90 reserve the name for future use.\ndiag-builtins-head: 109    We can still recognize the builtin in C90 mode but we can't produce it\ndiag-builtins-head: 110    implicitly.  */\ndiag-builtins-head: 111 #undef DEF_C99_C90RES_BUILTIN\t\t\t\t\t\ndiag-builtins-head: 112 #define DEF_C99_C90RES_BUILTIN(ENUM, NAME, TYPE, ATTRS)\t\\\ndiag-builtins-head: 113   DEF_BUILTIN (ENUM, \"__builtin_\" NAME, BUILT_IN_NORMAL, TYPE, TYPE,\t\\\ndiag-builtins-head: 114    \t       true, true, !flag_isoc99, ATTRS, TARGET_C99_FUNCTIONS, true)\ndiag-builtins-head: 115 \ndiag-builtins-head: 116 /* Allocate the enum and the name for a builtin, but do not actually\ndiag-builtins-head: 117    define it here at all.  */\ndiag-builtins-head: 118 #undef DEF_BUILTIN_STUB\ndiag-builtins-head: 119 #define DEF_BUILTIN_STUB(ENUM, NAME) \\\ndiag-builtins-head: 120   DEF_BUILTIN (ENUM, NAME, BUILT_IN_NORMAL, 0, 0, false, false, \\\ndiag-cparse: compile cparse_undef6_tree_builtin_empty\ndiag-cparse: cparse_undef6_tree_builtin_empty rc=0\ndiag-cparse: compile cparse_undef6_tree_builtin_complex_arith_only\ndiag-cparse: cparse_undef6_tree_builtin_complex_arith_only rc=0\ndiag-cparse: compile cparse_undef6_tree_builtin_include_full\ndiag-cparse: cparse_undef6_tree_builtin_include_full rc=0\ndiag-cparse: compile cparse_undef6_tree_builtin_include_plus_complex\ndiag-cparse: cparse_undef6_tree_builtin_include_plus_complex rc=0\ndiag-cparse: compile cparse_undef6_builtins_def_lines_20\nSegmentation fault (core dumped)\ndiag-cparse: cparse_undef6_builtins_def_lines_20 rc=139\ndiag-cparse: compile cparse_undef6_builtins_def_lines_60\nSegmentation fault (core dumped)\ndiag-cparse: cparse_undef6_builtins_def_lines_60 rc=139\ndiag-cparse: compile cparse_undef6_builtins_def_lines_120\nSegmentation fault (core dumped)\ndiag-cparse: cp
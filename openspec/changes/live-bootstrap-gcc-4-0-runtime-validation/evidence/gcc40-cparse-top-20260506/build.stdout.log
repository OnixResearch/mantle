e terms of the GNU General Public License as published by the Free\ndiag-machmode-head: 009 Software Foundation; either version 2, or (at your option) any later\ndiag-machmode-head: 010 version.\ndiag-machmode-head: 011 \ndiag-machmode-head: 012 GCC is distributed in the hope that it will be useful, but WITHOUT ANY\ndiag-machmode-head: 013 WARRANTY; without even the implied warranty of MERCHANTABILITY or\ndiag-machmode-head: 014 FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License\ndiag-machmode-head: 015 for more details.\ndiag-machmode-head: 016 \ndiag-machmode-head: 017 You should have received a copy of the GNU General Public License\ndiag-machmode-head: 018 along with GCC; see the file COPYING.  If not, write to the Free\ndiag-machmode-head: 019 Software Foundation, 59 Temple Place - Suite 330, Boston, MA\ndiag-machmode-head: 020 02111-1307, USA.  */\ndiag-machmode-head: 021 \ndiag-machmode-head: 022 #ifndef HAVE_MACHINE_MODES\ndiag-machmode-head: 023 #define HAVE_MACHINE_MODES\ndiag-machmode-head: 024 \ndiag-machmode-head: 025 /* Make an enum class that gives all the machine modes.  */\ndiag-machmode-head: 026 #include \"insn-modes.h\"\ndiag-machmode-head: 027 \ndiag-machmode-head: 028 /* Get the name of mode MODE as a string.  */\ndiag-machmode-head: 029 \ndiag-machmode-head: 030 extern const char * const mode_name[NUM_MACHINE_MODES];\ndiag-machmode-head: 031 #define GET_MODE_NAME(MODE)  mode_name[MODE]\ndiag-machmode-head: 032 \ndiag-machmode-head: 033 /* Mode classes.  */\ndiag-machmode-head: 034 \ndiag-machmode-head: 035 #include \"mode-classes.def\"\ndiag-machmode-head: 036 #define DEF_MODE_CLASS(M) M\ndiag-machmode-head: 037 enum mode_class { MODE_CLASSES, MAX_MODE_CLASS };\ndiag-machmode-head: 038 #undef DEF_MODE_CLASS\ndiag-machmode-head: 039 #undef MODE_CLASSES\ndiag-machmode-head: 040 \ndiag-machmode-head: 041 /* Get the general kind of object that mode MODE represents\ndiag-machmode-head: 042    (integer, floating, complex, etc.)  */\ndiag-machmode-head: 043 \ndiag-machmode-head: 044 extern const unsigned char mode_class[NUM_MACHINE_MODES];\ndiag-machmode-head: 045 #define GET_MODE_CLASS(MODE)  mode_class[MODE]\ndiag-machmode-head: 046 \ndiag-machmode-head: 047 /* Nonzero if MODE is an integral mode.  */\ndiag-machmode-head: 048 #define INTEGRAL_MODE_P(MODE)\t\t\t\\\ndiag-machmode-head: 049   (GET_MODE_CLASS (MODE) == MODE_INT\t\t\\\ndiag-machmode-head: 050    || GET_MODE_CLASS (MODE) == MODE_PARTIAL_INT \\\ndiag-machmode-head: 051    || GET_MODE_CLASS (MODE) == MODE_COMPLEX_INT \\\ndiag-machmode-head: 052    || GET_MODE_CLASS (MODE) == MODE_VECTOR_INT)\ndiag-machmode-head: 053 \ndiag-machmode-head: 054 /* Nonzero if MODE is a floating-point mode.  */\ndiag-machmode-head: 055 #define FLOAT_MODE_P(MODE)\t\t\\\ndiag-machmode-head: 056   (GET_MODE_CLASS (MODE) == MODE_FLOAT\t\\\ndiag-machmode-head: 057    || GET_MODE_CLASS (MODE) == MODE_COMPLEX_FLOAT \\\ndiag-machmode-head: 058    || GET_MODE_CLASS (MODE) == MODE_VECTOR_FLOAT)\ndiag-machmode-head: 059 \ndiag-machmode-head: 060 /* Nonzero if MODE is a complex mode.  */\ndiag-machmode-head: 061 #define COMPLEX_MODE_P(MODE)\t\t\t\\\ndiag-machmode-head: 062   (GET_MODE_CLASS (MODE) == MODE_COMPLEX_INT\t\\\ndiag-machmode-head: 063    || GET_MODE_CLASS (MODE) == MODE_COMPLEX_FLOAT)\ndiag-machmode-head: 064 \ndiag-machmode-head: 065 /* Nonzero if MODE is a vector mode.  */\ndiag-machmode-head: 066 #define VECTOR_MODE_P(MODE)\t\t\t\\\ndiag-machmode-head: 067   (GET_MODE_CLASS (MODE) == MODE_VECTOR_INT\t\\\ndiag-machmode-head: 068    || GET_MODE_CLASS (MODE) == MODE_VECTOR_FLOAT)\ndiag-machmode-head: 069 \ndiag-machmode-head: 070 /* Nonzero if MODE is a scalar integral mode.  */\ndiag-machmode-head: 071 #define SCALAR_INT_MODE_P(MODE)\t\t\t\\\ndiag-machmode-head: 072   (GET_MODE_CLASS (MODE) == MODE_INT\t\t\\\ndiag-machmode-head: 073    || GET_MODE_CLASS (MODE) == MODE_PARTIAL_INT)\ndiag-machmode-head: 074 \ndiag-machmode-head: 075 /* Nonzero if MODE is a scalar floating point mode.  */\ndiag-machmode-head: 076 #define SCALAR_FLOAT_MODE_P(MODE)\t\t\\\ndiag-machmode-head: 077   (GET_MODE_CLASS (MODE) == MODE_FLOAT)\ndiag-machmode-head: 078 \ndiag-machmode-head: 079 /* Get the size in bytes and bits of an object of mode MODE.  */\ndiag-machmode-head: 080 \ndiag-machmode-head: 081 extern CONST_MODE_SIZE unsigned char mode_size[NUM_MACHINE_MODES];\ndiag-machmode-head: 082 #define GET_MODE_SIZE(MODE)    ((unsigned short) mode_size[MODE])\ndiag-machmode-head: 083 #define GET_MODE_BITSIZE(MODE) ((unsigned short) (GET_MODE_SIZE (MODE) * BITS_PER_UNIT))\ndiag-machmode-head: 084 \ndiag-machmode-head: 085 /* Get the number of value bits of an object of mode MODE.  */\ndiag-machmode-head: 086 extern const unsigned short mode_precision[NUM_MACHINE_MODES];\ndiag-machmode-head: 087 #define GET_MODE_PRECISION(MODE)  mode_precision[MODE]\ndiag-machmode-head: 088 \ndiag-machmode-head: 089 /* Get a bitmask containing 1 for all bits in a word\ndiag-machmode-head: 090    that fit within mode MODE.  */\ndiag-machmode-head: 091 \ndiag-machmode-head: 092 extern const unsigned HOST_WIDE_INT mode_mask_array[NUM_MACHINE_MODES];\ndiag-machmode-head: 093 \ndiag-machmode-head: 094 #define GET_MODE_MASK(MODE) mode_mask_array[MODE]\ndiag-machmode-head: 095 \ndiag-machmode-head: 096 /* Return the mode of the inner elements in a vector.  */\ndiag-machmode-head: 097 \ndiag-machmode-head: 098 extern const unsigned char mode_inner[NUM_MACHINE_MODES];\ndiag-machmode-head: 099 #define GET_MODE_INNER(MODE) mode_inner[MODE]\ndiag-machmode-head: 100 \ndiag-machmode-head: 101 /* Get the size in bytes of the basic parts of an object of mode MODE.  */\ndiag-machmode-head: 102 \ndiag-machmode-head: 103 #define GET_MODE_UNIT_SIZE(MODE)\t\t\\\ndiag-machmode-head: 104   (GET_MODE_INNER (MODE) == VOIDmode\t\t\\\ndiag-machmode-head: 105    ? GET_MODE_SIZE (MODE)\t\t\t\\\ndiag-machmode-head: 106    : GET_MODE_SIZE (GET_MODE_INNER (MODE)))\ndiag-machmode-head: 107 \ndiag-machmode-head: 108 /* Get the number of units in the object.  */\ndiag-machmode-head: 109 \ndiag-machmode-head: 110 extern const unsigned char mode_nunits[NUM_MACHINE_MODES];\ndiag-machmode-head: 111 #define GET_MODE_NUNITS(MODE)  mode_nunits[MODE]\ndiag-machmode-head: 112 \ndiag-machmode-head: 113 /* Get the next wider natural mode (eg, QI -> HI -> SI -> DI -> TI).  */\ndiag-machmode-head: 114 \ndiag-machmode-head: 115 extern const unsigned char mode_wider[NUM_MACHINE_MODES];\ndiag-machmode-head: 116 #define GET_MODE_WIDER_MODE(MODE) mode_wider[MODE]\ndiag-machmode-head: 117 \ndiag-machmode-head: 118 /* Return the mode for data of a given size SIZE and mode class CLASS.\ndiag-machmode-head: 119    If LIMIT is nonzero, then don't use modes bigger than MAX_FIXED_MODE_SIZE.\ndiag-machmode-head: 120    The value is BLKmode if no other mode is found.  */\ndiag-machmode-head: 121 \ndiag-machmode-head: 122 extern enum machine_mode mode_for_size (unsigned int, enum mode_class, int);\ndiag-machmode-head: 123 \ndiag-machmode-head: 124 /* Similar, but find the smallest mode for a given width.  */\ndiag-machmode-head: 125 \ndiag-machmode-head: 126 extern enum machine_mode smallest_mode_for_size (unsigned int,\ndiag-machmode-head: 127 \t\t\t\t\t\t enum mode_class);\ndiag-machmode-head: 128 \ndiag-machmode-head: 129 \ndiag-machmode-head: 130 /* Return an integer mode of the exact same size as the input mode,\ndiag-machmode-head: 131    or BLKmode on failure.  */\ndiag-machmode-head: 132 \ndiag-machmode-head: 133 extern enum machine_mode int_mode_for_mode (enum machine_mode);\ndiag-machmode-head: 134 \ndiag-machmode-head: 135 /* Find the best mode to use to access a bit field.  */\ndiag-machmode-head: 136 \ndiag-machmode-head: 137 extern enum machine_mode get_best_mode (int, int, unsigned int,\ndiag-machmode-head: 138 \t\t\t\t\tenum machine_mode, int);\ndiag-machmode-head: 139 \ndiag-machmode-head: 140 /* Determine alignment, 1<=result<=BIGGEST_ALIGNMENT.  */\ndiag-cparse: c
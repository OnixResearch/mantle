{
  "source_prefixes": [
    "/gnu/store",
    "/nix/store"
  ],
  "target_prefix": "/mantle/store",
  "rewrite_builder": true,
  "rewrite_args": true,
  "rewrite_env": true,
  "rewrite_sources": true,
  "rewrite_declared_references": true,
  "allow_embedded_source_payload_rewrite": false,
  "builtin_mappings": {
    "builtin:download": "mantle.fetch",
    "fixed-output-fetch": "mantle.fetch",
    "nix.derivation": "mantle.derivation"
  },
  "output_path_recompute_mode": "recompute-blake3-v1",
  "trusted_cache_scopes": [],
  "allowed_sandbox_capabilities": []
}

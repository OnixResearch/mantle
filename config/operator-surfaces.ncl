flags | Array String,
exit_classes | Array String,
machine_schema | Dyn,
migration_reference | Dyn,
removal_gate | Dyn,
} in
let CommandEffects = {
reads_files | Bool,
writes_files | Bool,
uses_network | Bool,
starts_processes | Bool,
requires_trust_material | Bool,
} in
let PlatformProfile = {
command_root | String,
role | [| 'portable-client, 'portable-remote-build, 'remote-mixed, 'linux-local-executor, 'linux-worker-server, 'bootstrap, 'proof, 'internal |],
effects | CommandEffects,
darwin_support | [| 'supported, 'remote-required, 'mixed, 'unsupported |],
blocker | Dyn,
remote_capability_required | Bool,
trusted_builder_key_required | Bool,
} in
let Inventory = {
schema | String,
surfaces | Array Surface,
platform_profiles | Array PlatformProfile,
}

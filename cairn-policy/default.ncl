      { id = "clock_date_default", class = "clock_date", source = "archive default date", handling = "normalize", receipt_field = "entropy_assumptions", description = "Archive dry-run replay assumes the deterministic default archive date unless an explicit rejected override is present." },
      { id = "locale_timezone", class = "locale_timezone", source = "process locale and timezone", handling = "normalize", receipt_field = "entropy_assumptions", description = "Replay receipts use canonical JSON, sorted keys, and policy-owned string data rather than locale-sensitive formatting." },
      { id = "cwd_root_paths", class = "filesystem_path", source = "current working directory and replay root", handling = "normalize", receipt_field = "root,normalization_rules", description = "Root-specific checkout and temporary prefixes are normalized before portable hash computation; display paths remain operator-facing." },
      { id = "filesystem_order", class = "filesystem_metadata", source = "directory iteration order and file metadata", handling = "normalize", receipt_field = "mutability_observations", description = "Replay manifests sort root-relative paths and hash file contents; volatile host metadata is not part of portable evidence." },
      { id = "external_command_versions", class = "toolchain", source = "cairn binary, Nix/devshell, and external checker versions", handling = "disclose", receipt_field = "entropy_assumptions", description = "Replay discloses that toolchain identity is represented by policy and receipt hashes rather than raw host paths." },
      { id = "nix_build_context", class = "build_context", source = "Nix flake/devshell context", handling = "disclose", receipt_field = "entropy_assumptions", description = "Replay assumes a reviewed Nix-built Cairn surface and does not capture machine-specific store paths in portable evidence." },
    ],
    environment_attestation = [
      { id = "cairn_package_version", class = "binary_identity", source = "CARGO_PKG_VERSION", handling = "disclose", receipt_field = "environment_attestation.cairn_version", description = "Replay discloses the Cairn package name and version compiled into the binary, not the host binary path." },
      { id = "generated_policy_hash", class = "policy_identity", source = "cairn-policy/generated/cairn-policy.json", handling = "hash", receipt_field = "environment_attestation.generated_policy_hash", description = "Replay binds the generated policy content by BLAKE3 hash." },
      { id = "entropy_policy_hash", class = "entropy_policy_identity", source = "determinism_replay_policy.entropy_inventory", handling = "hash", receipt_field = "environment_attestation.entropy_policy_hash", description = "Replay binds the reviewed entropy inventory by BLAKE3 hash." },
      { id = "replay_selection", class = "selection_identity", source = "--case/--group/default replay selection", handling = "disclose", receipt_field = "environment_attestation.selected_cases,environment_attestation.selected_groups", description = "Replay discloses the selected case and group ids used to produce evidence." },
      { id = "attestation_policy", class = "attestation_policy_identity", source = "determinism_replay_policy.environment_attestation", handling = "hash", receipt_field = "environment_attestation.attestation_policy_hash", description = "Replay binds this reviewed environment attestation policy by BLAKE3 hash." },
      { id = "toolchain_build_context", class = "build_context", source = "Nix/devshell/toolchain context", handling = "disclose", receipt_field = "environment_attestation.policy_facts", description = "Replay discloses reviewed build/toolchain context as policy facts and avoids machine-specific store paths." },
    ],
  },

  determinism_surface_inventory = [
    { id = "agent_receipt_preserves_hash", command = "agent-receipt preserves-hash fixtures/agent-receipts/positive.json", surface_kind = "cli", receipt_command = "agent-receipt preserves-hash", required_replay_cases = ["agent_receipt_preserves_hash"], required_replay_groups = ["full"], determinism_claim = "agent_receipt_preserves_hash_stability" },
    { id = "agent_receipt_validate", command = "agent-receipt validate fixtures/agent-receipts/positive.json", surface_kind = "cli", receipt_command = "agent-receipt validate", required_replay_cases = ["agent_receipt_validate"], required_replay_groups = ["agent", "full", "release"], determinism_claim = "agent_receipt_stability" },
    { id = "archive_dry_run", command = "archive ready --root <root>", surface_kind = "cli", receipt_command = "archive", required_replay_cases = ["archive_dry_run"], required_replay_groups = ["full"], determinism_claim = "lifecycle_dry_run_stability" },
    { id = "gate_design", command = "gate design demo --root <root>", surface_kind = "cli", receipt_command = "gate", required_replay_cases = ["gate_design"], required_replay_groups = ["full"], determinism_claim = "gate_receipt_stability" },
    { id = "gate_proposal", command = "gate proposal demo --root <root>", surface_kind = "cli", receipt_command = "gate", required_replay_cases = ["gate_proposal"], required_replay_groups = ["full"], determinism_claim = "gate_receipt_stability" },
    { id = "gate_tasks", command = "gate tasks demo --root <root>", surface_kind = "cli", receipt_command = "gate", required_replay_cases = ["gate_tasks"], required_replay_groups = ["full"], determinism_claim = "gate_receipt_stability" },
    { id = "mcp_describe", command = "mcp --describe", surface_kind = "mcp", receipt_command = "mcp describe", required_replay_cases = ["mcp_describe"], required_replay_groups = ["agent", "full", "release"], determinism_claim = "mcp_catalog_stability" },
    { id = "mcp_status", command = "mcp --call cairn_status", surface_kind = "mcp", receipt_command = "cairn_status", required_replay_cases = ["mcp_status"], required_replay_groups = ["full"], determinism_claim = "mcp_receipt_stability" },
    { id = "migrate_dry_run", command = "migrate openspec --root <root>", surface_kind = "cli", receipt_command = "migrate", required_replay_cases = ["migrate_dry_run"], required_replay_groups = ["full"], determinism_claim = "migration_dry_run_stability" },
    { id = "release_readiness", command = "release-readiness --root <root>", surface_kind = "cli", receipt_command = "release-readiness", required_replay_cases = ["release_readiness"], required_replay_groups = ["full", "release"], determinism_claim = "release_receipt_stability" },
    { id = "preserves_corpus_freshness", command = "preserves-corpus update --path fixtures/preserves-canonicalization/corpus.json", surface_kind = "cli", receipt_command = "preserves-corpus update", required_replay_cases = ["preserves_corpus_freshness"], required_replay_groups = ["full"], determinism_claim = "preserves_corpus_freshness_stability" },
    { id = "evidence_registry_build", command = "evidence registry build --root <root> --index <index> --out <out>", surface_kind = "cli", receipt_command = "evidence registry build", required_replay_cases = ["validate"], required_replay_groups = ["smoke", "full"], determinism_claim = "evidence_registry_stability" },
    { id = "evidence_registry_verify", command = "evidence registry verify --root <root> --registry <registry>", surface_kind = "cli", receipt_command = "evidence registry verify", required_replay_cases = ["validate"], required_replay_groups = ["smoke", "full"], determinism_claim = "evidence_registry_verification_stability" },
    { id = "evidence_registry_mirror_verify", command = "evidence registry mirror-verify --root <root> --registry <registry> --mirror <mirror>", surface_kind = "cli", receipt_command = "evidence registry mirror-verify", required_replay_cases = ["validate"], required_replay_groups = ["smoke", "full"], determinism_claim = "evidence_registry_mirror_verification_stability" },
    { id = "evidence_registry_select", command = "evidence registry select --root <root> --registry <registry> --bundle-kind <kind> --out <out>", surface_kind = "cli", receipt_command = "evidence registry select", required_replay_cases = ["validate"], required_replay_groups = ["smoke", "full"], determinism_claim = "evidence_registry_selection_stability" },
    { id = "evidence_registry_fetch_plan", command = "evidence registry fetch-plan --root <root> --registry <registry> --out <out>", surface_kind = "cli", receipt_command = "evidence registry fetch-plan", required_replay_cases = ["validate"], required_replay_groups = ["smoke", "full"], determinism_claim = "evidence_registry_fetch_plan_stability" },

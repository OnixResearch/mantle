  exemption_marker_policy = {
    required_fields = ["reason", "owner", "until"],
    date_fields = ["until"],
    optional_fields = ["scope"],
  },

  sync_archive_policy = {
    require_all_tasks_done = true,
    archive_date_prefix = true,
    default_archive_dir = "cairn/archive",
  },

  mutation_policy = {
    sync = { require_passing_gate = true },
    archive = { require_passing_gate = true },
    migrate = { require_manifest = true },
  },

  receipt_hash_policy = {
    required = true,
    algorithm = "BLAKE3",
    canonicalization = "serde_json_compact_sorted_keys",
  },

  exemptions = [],
  agent_guidance_policy = {
    "allowed_authority_classes" = [
      "project_fact",
      "advisory_guidance",
    ],
    "allowed_source_roots" = [
      "project",
      "lifecycle",
    ],
    "bounds" = {
      "max_artifact_guidance" = 64,
      "max_context_refs" = 64,
      "max_id_bytes" = 128,
      "max_inline_text_bytes" = 65536,
      "max_issues" = 128,
      "max_operation_guidance" = 64,
      "max_path_bytes" = 512,
      "max_priority" = 10000,
      "max_selectors_per_entry" = 32,
      "max_source_text_bytes" = 262144,
    },
    "known_artifacts" = [
      "proposal",
      "specs",
      "design",
      "tasks",
      "risk",
      "verification",
      "assurance-review",
      "acceptance",
      "no-spec-review",
    ],
    "known_operations" = [
      "context",
      "workflow-instructions",
    ],
    "known_profiles" = [
      "spec-driven",
      "assurance",
      "no-spec-delta",
    ],
    "portable_excluded_fields" = [
      "text",
      "absolute_path",
    ],
    "receipt_fields" = [
      "valid",
      "request",
      "bounds",
      "entries",
      "portable_entries",
      "issues",
      "local_result_hash",
      "portable_identity",
      "project_identity",
      "policy_hash",
      "non_claims",
    ],
    "required_non_claims" = [
      "project facts and advisory guidance do not override generated policy or command authorization",
      "context identity binds observed bytes but does not prove truth, freshness beyond those bytes, or semantic consistency",
      "path, encoding, size, and omission checks do not prove that declared text is secret-free or safe to disclose",
      "guidance selection does not satisfy gates, dependencies, evidence, implementation correctness, or release eligibility",
      "portable guidance identity omits raw text and absolute paths by default",
    ],
    "schema" = "cairn.agent-guidance-policy.v1",
  },

  developer_loop_policy = {
    "bounds" = {
      "max_budgets" = 8,
      "max_cache_key_inputs" = 8,
      "max_checks" = 32,
      "max_checks_per_profile" = 16,
      "max_duration_seconds" = 3600,
      "max_issues" = 64,
      "max_profiles" = 8,
      "max_receipt_bytes" = 65536,
      "max_text_bytes" = 4096,

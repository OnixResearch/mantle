  "x-mantle-invariants": [
    { "kind": "field-equals", "left": "/valid", "right": "/verification_summary/valid" },
    { "kind": "field-equals", "left": "/disposition", "right": "/verification_summary/disposition" },
    { "kind": "field-equals", "left": "/sidecar_digest", "right": "/verification_summary/sidecar_digest_blake3" },
    { "kind": "field-equals", "left": "/valence_receipt_digest", "right": "/verification_summary/valence_receipt_digest_blake3" },
    { "kind": "field-equals", "left": "/source_archive_digest", "right": "/verification_summary/source_archive_digest_blake3" },
    { "kind": "field-equals", "left": "/release_binary_digest", "right": "/verification_summary/release_binary_digest_blake3" },
    { "kind": "field-equals", "left": "/kamacite_receipt_digest", "right": "/verification_summary/kamacite_receipt_digest_blake3" },
    { "kind": "field-equals", "left": "/mantle_non_claim_boundary", "right": "/verification_summary/boundary" },
    { "kind": "field-equals-const-when", "boolean": "/valid", "target": "/verdict", "value": "PASS" },
    { "kind": "field-equals-const-when", "boolean": "/valid", "target": "/disposition", "value": "present" }
  ]

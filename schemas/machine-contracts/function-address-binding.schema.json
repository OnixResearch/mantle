        "enum": [
          "function-address-evidence-sidecar",
          "valence-function-address-evidence-profile",
          "kamacite-function-address-receipt"
        ]
      }
    },
    "schemas": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "x-mantle-bound-name": {
        "minItems": "MIN_FUNCTION_ADDRESS_BINDING_ROLES_COUNT",
        "maxItems": "MAX_FUNCTION_ADDRESS_BINDING_ROLES_COUNT"
      },
      "items": {
        "type": "string",
        "enum": [
          "valence.function-address-evidence.v1",
          "function-address-evidence-v1",
          "kamacite.function-address-receipt.v1"
        ]
      }
    },
    "mantle_non_claim_boundary": {
      "type": "string",
      "const": "Mantle validates bundle-local function-address evidence path, digest, role, schema, claim scope, source archive identity, binary identity, and non-claims only; Octet owns Rust extraction, Kamacite owns portable receipts, and Valence owns evidence semantics",
      "x-mantle-issue-class": "enum"
    },
    "non_claim_boundary": {
      "type": "string",
      "const": "Cairn function-address evidence proves lifecycle policy conformance over supplied receipts only; it does not prove Rust semantic correctness, compiler correctness, build correctness, verifier soundness, or release eligibility outside the configured policy",

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mantle://schemas/source/source-observation-v1",
  "title": "Mantle source observation",
  "x-mantle-rust-owner": "crates/crunch-source-core/src/observation.rs::SourceObservationWire",
  "$defs": {
    "immutable_revision": {
      "type": "object",
      "required": ["object_format", "value"],
      "properties": {
        "object_format": { "type": "string", "enum": ["sha1", "sha256"] },
        "value": { "type": "string", "minLength": 40, "maxLength": 64, "x-mantle-bound-name": { "minLength": "GIT_SHA1_HEX_CHARS", "maxLength": "GIT_SHA256_HEX_CHARS" }, "x-mantle-length-unit": "utf8-bytes" }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["schema", "source_kind", "locator_class", "normalized_projection", "snapshot_profile", "content_blake3", "observation_blake3", "provenance", "non_claim"],
  "properties": {
    "schema": { "type": "string", "const": "mantle-source-observation-v1", "x-mantle-issue-class": "version" },
    "source_kind": { "type": "string", "enum": ["fixed-url", "vcs-snapshot", "local-logical", "package-mirror", "opaque-adapter"] },
    "locator_class": { "type": "string", "enum": ["url", "git-remote", "logical-path", "mirror", "opaque"] },
    "locator_hint": { "type": "string", "minLength": 1, "maxLength": 4096, "x-mantle-bound-name": { "minLength": "SOURCE_HINT_BYTES_MIN", "maxLength": "LOCATOR_HINT_BYTES_MAX" }, "x-mantle-length-unit": "utf8-bytes", "x-mantle-semantic": "safe-reference" },
    "immutable_revision": { "$ref": "#/$defs/immutable_revision" },
    "normalized_projection": { "type": "string", "minLength": 1, "maxLength": 4096, "x-mantle-bound-name": { "minLength": "SOURCE_PROJECTION_BYTES_MIN", "maxLength": "PROJECTION_BYTES_MAX" }, "x-mantle-length-unit": "utf8-bytes" },
    "snapshot_profile": { "type": "string", "enum": ["flat-file-v1", "canonical-tree-v1", "archive-tree-v1", "opaque-v1"] },
    "content_blake3": { "type": "string", "x-mantle-semantic": "blake3" },
    "observation_blake3": { "type": "string", "x-mantle-semantic": "blake3" },
    "mutable_reference_hint": { "type": "string", "minLength": 1, "maxLength": 1024, "x-mantle-bound-name": { "minLength": "SOURCE_HINT_BYTES_MIN", "maxLength": "MUTABLE_REFERENCE_HINT_BYTES_MAX" }, "x-mantle-length-unit": "utf8-bytes", "x-mantle-semantic": "safe-reference" },
    "provenance": { "type": "string", "enum": ["complete", "unavailable-legacy-v1"] },
    "non_claim": { "type": "string", "const": "source-observation-binds-supplied-origin-projection-profile-and-content-facts-without-proving-ownership-trust-review-or-correctness" }
  },
  "additionalProperties": false
}

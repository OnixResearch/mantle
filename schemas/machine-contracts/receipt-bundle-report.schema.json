{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mantle://schemas/receipt/bundle-report-v1",
  "title": "Mantle portable receipt bundle report",
  "x-mantle-rust-owner": "src/portable_receipt.rs::ReceiptBundleReport",
  "$defs": {
    "kind": { "type": "string", "enum": ["source-ref", "action-ref", "sandbox-report", "network-policy", "reference-scan", "output-ref", "artifact-attestation", "closure-attestation", "semantic-graph-edge", "trust-basis", "signature"] },
    "record": {
      "type": "object",
      "required": ["kind", "identity", "digest"],
      "properties": {
        "kind": { "$ref": "#/$defs/kind" },
        "identity": { "type": "string", "maxLength": 4096, "x-mantle-bound-name": { "maxLength": "MAX_RECEIPT_FIELD_BYTES" }, "x-mantle-length-unit": "utf8-bytes", "x-mantle-semantic": "safe-reference" },
        "digest": { "type": "string", "x-mantle-semantic": "mantle-digest" }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["format", "store_prefix", "claim_strength", "evidence_complete", "missing_evidence", "output_identities", "records", "record_count", "bundle_blake3", "non_claim"],
  "properties": {
    "format": { "type": "string", "const": "mantle-build-receipt-bundle-v1", "x-mantle-issue-class": "version" },
    "store_prefix": { "type": "string", "x-mantle-semantic": "safe-reference" },
    "claim_strength": { "type": "string", "enum": ["diagnostic", "strong-action-correctness", "release-facing"] },
    "evidence_complete": { "type": "boolean" },
    "missing_evidence": { "type": "array", "maxItems": 11, "x-mantle-bound-name": { "maxItems": "RECEIPT_RECORD_KIND_COUNT" }, "items": { "$ref": "#/$defs/kind" } },
    "output_identities": { "type": "array", "maxItems": 65536, "x-mantle-bound-name": { "maxItems": "MAX_RECEIPT_RECORDS" }, "items": { "type": "string", "x-mantle-semantic": "safe-reference" } },
    "records": { "type": "array", "minItems": 1, "maxItems": 65536, "x-mantle-bound-name": { "minItems": "MIN_RECEIPT_RECORDS", "maxItems": "MAX_RECEIPT_RECORDS" }, "items": { "$ref": "#/$defs/record" } },
    "record_count": { "type": "integer", "minimum": 1, "maximum": 65536, "x-mantle-bound-name": { "minimum": "MIN_RECEIPT_RECORDS", "maximum": "MAX_RECEIPT_RECORDS" } },
    "bundle_blake3": { "type": "string", "x-mantle-semantic": "blake3" },
    "non_claim": { "type": "string", "const": "receipt bundle evidence proves only matched receipt, attestation, graph, and trust-basis facts" }
  },
  "additionalProperties": false,
  "x-mantle-invariants": [
    { "kind": "length-equals", "array": "/records", "integer": "/record_count" },
    { "kind": "empty-iff", "array": "/missing_evidence", "boolean": "/evidence_complete" },
    { "kind": "unique-by", "array": "/output_identities", "item_field": "" }
  ]
}

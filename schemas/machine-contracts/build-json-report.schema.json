      "determinism": { "type": ["object", "null"], "required": ["digest_algorithm", "policy_digest_blake3", "controls", "unsupported_controls", "divergence", "strong_claim_blocked"], "properties": { "digest_algorithm": { "type": "string", "const": "blake3" }, "policy_digest_blake3": { "type": "string", "x-mantle-semantic": "blake3" }, "controls": { "type": "array", "maxItems": 65536, "x-mantle-bound-name": { "maxItems": "MAX_BUILD_REPORT_ROWS" }, "items": { "$ref": "#/$defs/determinism_control" } }, "unsupported_controls": { "$ref": "#/$defs/string_array" }, "divergence": { "type": ["object", "null"], "required": ["status", "surface", "left_digest_blake3", "right_digest_blake3", "diagnostic"], "properties": { "status": { "type": "string", "x-mantle-semantic": "non-empty" }, "surface": { "type": "string", "x-mantle-semantic": "non-empty" }, "left_digest_blake3": { "type": "string", "x-mantle-semantic": "blake3" }, "right_digest_blake3": { "type": "string", "x-mantle-semantic": "blake3" }, "diagnostic": { "type": "string", "x-mantle-semantic": "redaction-safe" } }, "additionalProperties": false }, "strong_claim_blocked": { "type": "boolean" } }, "additionalProperties": false }

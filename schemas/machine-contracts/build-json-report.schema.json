": { "type": "string", "x-mantle-semantic": "non-empty" }, "result": { "type": "string", "x-mantle-semantic": "non-empty" }, "allow_undeclared_network": { "type": "boolean" } }, "additionalProperties": false }, "output": { "type": ["object", "null"], "required": ["binary", "path"], "properties": { "binary": { "type": "string", "x-mantle-semantic": "non-empty" }, "path": { "type": "string", "x-mantle-semantic": "safe-reference" } }, "additionalProperties": false }, "source_closure": { "type": "array", "maxItems": 65536, "x-mantle-bound-name": { "maxItems": "MAX_BUILD_REPORT_ROWS" }, "items": { "$ref": "#/$defs/source_entry" } }, "toolchain": { "$ref": "#/$defs/toolchain" }, "non_claims": { "$ref": "#/$defs/string_array" } }, "additionalProperties": false },

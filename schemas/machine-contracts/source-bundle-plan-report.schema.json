{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mantle://schemas/source-bundle/plan-report-v1",
  "title": "Mantle source bundle plan report",
  "x-mantle-rust-owner": "src/source_bundle.rs::SourceBundlePlanReport",
  "$defs": {
    "kind": { "type": "string", "enum": ["fixed-url", "local-path", "vcs-snapshot", "package-mirror", "bootstrap-archive", "provider-manifest", "toolchain-source-root", "proof-input"] },
    "readiness": { "type": "string", "enum": ["ready", "missing", "stale", "unsupported", "untrusted", "network-required", "unpinned"] },
    "record": {
      "type": "object",
      "required": ["kind", "identity", "payload_bytes", "content_blake3", "file_count"],
      "properties": {
        "kind": { "$ref": "#/$defs/kind" },
        "identity": { "type": "string", "maxLength": 512, "x-mantle-bound-name": { "maxLength": "MAX_SOURCE_ID_BYTES" }, "x-mantle-length-unit": "utf8-bytes", "x-mantle-semantic": "safe-reference" },
        "payload_bytes": { "type": "integer", "minimum": 0, "maximum": 1099511627776, "x-mantle-bound-name": { "minimum": "MIN_SOURCE_BYTES", "maximum": "MAX_SOURCE_TOTAL_BYTES" } },
        "content_blake3": { "type": "string", "x-mantle-semantic": "blake3" },
        "file_count": { "type": "integer", "minimum": 0, "maximum": 262144, "x-mantle-bound-name": { "minimum": "MIN_SOURCE_FILES", "maximum": "MAX_SOURCE_FILES_PER_RECORD" } }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["format", "store_prefix", "record_count", "payload_bytes", "ready_class", "records", "non_claim"],
  "properties": {
    "format": { "type": "string", "const": "mantle-source-bundle-v1", "x-mantle-issue-class": "version" },
    "store_prefix": { "type": "string", "x-mantle-semantic": "safe-reference" },
    "record_count": { "type": "integer", "minimum": 1, "maximum": 65536, "x-mantle-bound-name": { "minimum": "MIN_SOURCE_RECORDS", "maximum": "MAX_SOURCE_RECORDS" } },
    "payload_bytes": { "type": "integer", "minimum": 0, "maximum": 1099511627776, "x-mantle-bound-name": { "minimum": "MIN_SOURCE_BYTES", "maximum": "MAX_SOURCE_TOTAL_BYTES" } },
    "ready_class": { "$ref": "#/$defs/readiness" },
    "records": { "type": "array", "minItems": 1, "maxItems": 65536, "x-mantle-bound-name": { "minItems": "MIN_SOURCE_RECORDS", "maxItems": "MAX_SOURCE_RECORDS" }, "items": { "$ref": "#/$defs/record" } },
    "non_claim": { "type": "string", "const": "source bundle evidence proves declared source/input availability and identity only" }
  },
  "additionalProperties": false,
  "x-mantle-invariants": [
    { "kind": "length-equals", "array": "/records", "integer": "/record_count" },
    { "kind": "unique-by", "array": "/records", "item_field": "/identity" }
  ]
}

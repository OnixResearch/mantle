{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mantle://schemas/remote/trellis-admission-evidence-v1",
  "title": "Mantle Trellis remote-admission evidence",
  "x-mantle-rust-owner": "crates/crunch-release-core/src/trellis_admission_evidence.rs::TrellisRemoteAdmissionEvidenceReport",
  "$defs": {
    "blake3": {
      "type": "string",
      "x-mantle-semantic": "blake3"
    },
    "revision": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "x-mantle-bound-name": { "minLength": "REVISION_HEX_LENGTH", "maxLength": "REVISION_HEX_LENGTH" },
      "x-mantle-length-unit": "utf8-bytes"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "x-mantle-bound-name": { "minLength": "TEXT_BYTES_MIN", "maxLength": "TEXT_BYTES_MAX" },
      "x-mantle-length-unit": "utf8-bytes"
    },
    "text_array": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "x-mantle-bound-name": { "minItems": "TEXT_ITEMS_MIN", "maxItems": "TEXT_ITEMS_MAX" },
      "items": { "$ref": "#/$defs/text" }
    },
    "property": {
      "type": "object",
      "required": ["id", "requirement_id", "proof_function"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "requirement_id": { "$ref": "#/$defs/text" },
        "proof_function": { "$ref": "#/$defs/text" }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schema",
    "trellis",
    "mantle",
    "proof",
    "kamacite",
    "valence",
    "assumptions",
    "claims",
    "non_claims",
    "runtime_authority"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "mantle-trellis-remote-admission-evidence-v1",
      "x-mantle-issue-class": "version"
    },
    "trellis": {
      "type": "object",
      "required": ["repository", "revision", "model_tree_oid", "source_archive_blake3", "source_archive_bytes"],
      "properties": {
        "repository": { "type": "string", "const": "github.com/OnixResearch/trellis" },
        "revision": { "$ref": "#/$defs/revision" },
        "model_tree_oid": { "$ref": "#/$defs/revision" },
        "source_archive_blake3": { "$ref": "#/$defs/blake3" },
        "source_archive_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576, "x-mantle-bound-name": { "minimum": "SOURCE_BYTES_MIN", "maximum": "SOURCE_BYTES_MAX" } }
      },
      "additionalProperties": false
    },
    "mantle": {
      "type": "object",
      "required": [
        "projection_source_blake3",
        "remote_attempt_source_blake3",
        "oracle_manifest_blake3",
        "oracle_matrix_blake3",
        "oracle_case_count",
        "supported_case_count",
        "unsupported_case_count",
        "projection_counts",
        "policy_blake3"
      ],
      "properties": {
        "projection_source_blake3": { "$ref": "#/$defs/blake3" },
        "remote_attempt_source_blake3": { "$ref": "#/$defs/blake3" },
        "oracle_manifest_blake3": { "$ref": "#/$defs/blake3" },
        "oracle_matrix_blake3": { "$ref": "#/$defs/blake3" },
        "oracle_case_count": { "type": "integer", "const": 6720 },
        "supported_case_count": { "type": "integer", "minimum": 1, "maximum": 6720, "x-mantle-bound-name": { "minimum": "SUPPORTED_CASES_MIN", "maximum": "ORACLE_CASES" } },
        "unsupported_case_count": { "type": "integer", "minimum": 1, "maximum": 6720, "x-mantle-bound-name": { "minimum": "UNSUPPORTED_CASES_MIN", "maximum": "ORACLE_CASES" } },
        "projection_counts": {
          "type": "object",
          "required": [
            "authority-meaning-mismatch",
            "authority-order-mismatch",
            "history-order-mismatch",
            "phase-report-mismatch",
            "result-retention-mismatch",
            "supported"
          ],
          "properties": {
            "authority-meaning-mismatch": { "type": "integer", "minimum": 1, "maximum": 6720, "x-mantle-bound-name": { "minimum": "COUNT_MIN", "maximum": "ORACLE_CASES" } },
            "authority-order-mismatch": { "type": "integer", "minimum": 1, "maximum": 6720, "x-mantle-bound-name": { "minimum": "COUNT_MIN", "maximum": "ORACLE_CASES" } },
            "history-order-mismatch": { "type": "integer", "minimum": 1, "maximum": 6720, "x-mantle-bound-name": { "minimum": "COUNT_MIN", "maximum": "ORACLE_CASES" } },
            "phase-report-mismatch": { "type": "integer", "minimum": 1, "maximum": 6720, "x-mantle-bound-name": { "minimum": "COUNT_MIN", "maximum": "ORACLE_CASES" } },
            "result-retention-mismatch": { "type": "integer", "minimum": 1, "maximum": 6720, "x-mantle-bound-name": { "minimum": "COUNT_MIN", "maximum": "ORACLE_CASES" } },
            "supported": { "type": "integer", "minimum": 1, "maximum": 6720, "x-mantle-bound-name": { "minimum": "COUNT_MIN", "maximum": "ORACLE_CASES" } }
          },
          "additionalProperties": false
        },
        "policy_blake3": { "$ref": "#/$defs/blake3" }
      },
      "additionalProperties": false
    },
    "proof": {
      "type": "object",
      "required": ["proof_ir_blake3", "verifier_receipt_blake3", "properties", "requirement_ids", "verification_status"],
      "properties": {
        "proof_ir_blake3": { "$ref": "#/$defs/blake3" },
        "verifier_receipt_blake3": { "$ref": "#/$defs/blake3" },
        "properties": { "type": "array", "minItems": 8, "maxItems": 8, "x-mantle-bound-name": { "minItems": "PROPERTY_COUNT", "maxItems": "PROPERTY_COUNT" }, "items": { "$ref": "#/$defs/property" } },
        "requirement_ids": { "type": "array", "minItems": 8, "maxItems": 8, "x-mantle-bound-name": { "minItems": "REQUIREMENT_COUNT", "maxItems": "REQUIREMENT_COUNT" }, "items": { "$ref": "#/$defs/text" } },
        "verification_status": { "type": "string", "const": "passed" }
      },
      "additionalProperties": false
    },
    "kamacite": {
      "type": "object",
      "required": ["revision", "profile", "producer_role", "canonical_path", "canonical_blake3", "canonical_bytes", "profile_identity_blake3", "projection_path", "projection_blake3"],
      "properties": {
        "revision": { "$ref": "#/$defs/revision" },
        "profile": { "type": "string", "const": "kamacite.trellis-proof-evidence-profile.v1" },
        "producer_role": { "type": "string", "const": "formal-proof-candidate" },
        "canonical_path": { "$ref": "#/$defs/text" },
        "canonical_blake3": { "$ref": "#/$defs/blake3" },
        "canonical_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576, "x-mantle-bound-name": { "minimum": "CANONICAL_BYTES_MIN", "maximum": "CANONICAL_BYTES_MAX" } },
        "profile_identity_blake3": { "$ref": "#/$defs/blake3" },
        "projection_path": { "$ref": "#/$defs/text" },
        "projection_blake3": { "$ref": "#/$defs/blake3" }
      },
      "additionalProperties": false
    },
    "valence": {
      "type": "object",
      "required": ["revision", "schema", "validation_role", "outcome", "valid", "artifact_path", "artifact_blake3", "receipt_hash_blake3"],
      "properties": {
        "revision": { "$ref": "#/$defs/revision" },
        "schema": { "type": "string", "const": "trellis.proof-evidence" },
        "validation_role": { "type": "string", "const": "property" },
        "outcome": { "type": "string", "const": "accepted_formal_proof" },
        "valid": { "type": "boolean", "const": true },
        "artifact_path": { "$ref": "#/$defs/text" },
        "artifact_blake3": { "$ref": "#/$defs/blake3" },
        "receipt_hash_blake3": { "$ref": "#/$defs/blake3" }
      },
      "additionalProperties": false
    },
    "assumptions": { "$ref": "#/$defs/text_array" },
    "claims": { "type": "array", "minItems": 1, "maxItems": 1, "x-mantle-bound-name": { "minItems": "CLAIM_COUNT", "maxItems": "CLAIM_COUNT" }, "items": { "type": "string", "const": "the named abstract fenced-attempt safety properties agree for the recorded supported projection cases" } },
    "non_claims": { "type": "array", "minItems": 8, "maxItems": 8, "x-mantle-bound-name": { "minItems": "NON_CLAIM_COUNT", "maxItems": "NON_CLAIM_COUNT" }, "items": { "$ref": "#/$defs/text" } },
    "runtime_authority": { "type": "string", "const": "unchanged-plan_remote_attempt_report" }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mantle://schemas/radiance/radiance-reference-proof-report-v1",
  "title": "Mantle Radiance reference proof report",
  "x-mantle-rust-owner": "src/radiance/workflow/view.rs::ProofReport",
  "type": "object",
  "required": ["schema", "disposition", "receipt_blake3", "source_bundle_blake3", "source_cohort_blake3", "plan_blake3", "protected_execution_audit_blake3", "fixed_point_blake3", "fixed_point_bytes", "output_path", "proof_time_network_requests", "proof_success", "non_claim"],
  "properties": {
    "schema": { "type": "string", "const": "mantle-radiance-reference-proof-report-v1", "x-mantle-issue-class": "version" },
    "disposition": { "type": "string", "enum": ["match", "divergence", "unexpected-output"] },
    "receipt_blake3": { "type": "string", "x-mantle-semantic": "blake3", "x-mantle-issue-class": "digest" },
    "source_bundle_blake3": { "type": "string", "x-mantle-semantic": "blake3" },
    "source_cohort_blake3": { "type": "string", "x-mantle-semantic": "blake3" },
    "plan_blake3": { "type": "string", "x-mantle-semantic": "blake3" },
    "protected_execution_audit_blake3": { "type": "string", "x-mantle-semantic": "blake3" },
    "fixed_point_blake3": { "type": "string", "x-mantle-semantic": "blake3" },
    "fixed_point_bytes": { "type": "integer", "minimum": 1, "maximum": 67108864, "x-mantle-bound-name": { "minimum": "RADIANCE_ARTIFACT_BYTES_MIN", "maximum": "RADIANCE_ARTIFACT_BYTES_MAX" } },
    "output_path": { "type": "string", "maxLength": 4096, "x-mantle-bound-name": { "maxLength": "RADIANCE_TEXT_BYTES_MAX" }, "x-mantle-length-unit": "utf8-bytes", "x-mantle-semantic": "safe-reference" },
    "proof_time_network_requests": { "type": "integer", "const": 0, "x-mantle-issue-class": "bounds" },
    "proof_success": { "type": "boolean" },
    "non_claim": { "type": "string", "const": "radiance-reference-records-bounded-source-lineage-execution-and-convergence-facts-without-proving-compiler-correctness-seed-trust-semantic-equivalence-or-universal-reproducibility", "x-mantle-issue-class": "cross-field" }
  },
  "additionalProperties": false
}

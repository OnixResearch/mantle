//! Loaded only at the source compiler's process entry, before logger, signal
//! handler or compiler thread initialization. Not a child-launching wrapper.
use std::collections::BTreeSet;
use std::io::{self, Read};

const MAX_BYTES: u64 = 64 * 1024 * 1024;

pub(super) fn load() -> io::Result<()> {
    let Some(path) = std::env::var_os("MANTLE_CAIRN_COMPILE_ENV") else {
        return Ok(());
    };
    let mut bytes = Vec::new();
    std::fs::File::open(path)?.take(MAX_BYTES + 1).read_to_end(&mut bytes)?;
    if bytes.len() as u64 > MAX_BYTES {
        return Err(invalid("compiler environment frame exceeds its bound"));
    }
    let mut cursor = 0;
    let mut keys = BTreeSet::new();
    let mut values = Vec::new();
    while cursor < bytes.len() {
        let key_length = length(&bytes, &mut cursor)?;
        let value_length = length(&bytes, &mut cursor)?;
        let key = field(&bytes, &mut cursor, key_length)?;
        let value = field(&bytes, &mut cursor, value_length)?;
        if key.is_empty() || key.contains('=') || key.contains('\0') || value.contains('\0') {
            return Err(invalid("invalid compiler environment key/value"));
        }
        if !keys.insert(key) {
            return Err(invalid("duplicate compiler environment key"));
        }
        values.push((key, value));
    }
    // Validate the complete frame before changing any process environment.
    // SAFETY: the injected call is the first operation of rustc_driver_impl::main,
    // before the logger, signal handlers and compiler worker threads are created.
    // This mode is not exposed through the multithreaded embedding entry point.
    for (key, value) in values {
        unsafe { std::env::set_var(key, value) };
    }
    Ok(())
}

fn length(bytes: &[u8], cursor: &mut usize) -> io::Result<usize> {
    let end = cursor.checked_add(4).ok_or_else(|| invalid("environment frame length overflow"))?;
    let length = bytes.get(*cursor..end).ok_or_else(|| invalid("truncated environment frame length"))?;
    *cursor = end;
    Ok(u32::from_le_bytes(length.try_into().unwrap()) as usize)
}

fn field<'a>(bytes: &'a [u8], cursor: &mut usize, length: usize) -> io::Result<&'a str> {
    let end = cursor.checked_add(length).ok_or_else(|| invalid("environment frame field overflow"))?;
    let field = bytes.get(*cursor..end).ok_or_else(|| invalid("truncated environment frame field"))?;
    let field = std::str::from_utf8(field).map_err(|_| invalid("non-UTF8 compiler environment frame"))?;
    *cursor = end;
    Ok(field)
}

fn invalid(message: &str) -> io::Error {
    io::Error::new(io::ErrorKind::InvalidData, message)
}
